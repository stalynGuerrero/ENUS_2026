"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"d6e5dddf-6c2b-47f1-a163-330e820fe3b3\"><\u002Fscript>\n<script src=\"7ce6181b-b04e-4a8a-a660-8082e6fd2604\"><\u002Fscript>\n<\u002Fhead>\n<body>\n\n<x-dc>\n<helmet>\n<style>\n@font-face{font-family:'Nunito Sans';src:url(\"993b5184-e66e-4a6e-a40e-c6f218400124\") format('truetype');font-weight:200 1000;font-style:normal;}\nbody{margin:0;background:linear-gradient(145deg,#E7F6F4,#EAF7EE 55%,#EAF0FA);min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:'Nunito Sans',Verdana,sans-serif;}\na{color:#1F8A80;text-decoration:none;}\na:hover{color:#003189;text-decoration:underline;}\n@keyframes spin{to{transform:rotate(360deg)}}\n@keyframes popIn{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}\n@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n*{box-sizing:border-box}\n::-webkit-scrollbar{width:3px}\n::-webkit-scrollbar-thumb{background:rgba(50,177,165,.5);border-radius:3px}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"width:375px;height:812px;background:#080810;border-radius:52px;padding:12px;box-shadow:0 0 0 2px #14142A,0 0 0 4px #0A0A1A,0 40px 80px rgba(0,0,0,.45);position:relative;display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;margin:24px 0;\">\n  <div style=\"width:126px;height:26px;background:#080810;border-radius:0 0 18px 18px;margin:0 auto;flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:7px;position:absolute;top:12px;left:50%;transform:translateX(-50%);z-index:40;\">\n    <div style=\"width:24px;height:5px;border-radius:3px;background:#181830;\"><\u002Fdiv>\n    <div style=\"width:10px;height:10px;border-radius:50%;background:#181830;border:1.5px solid #242448;\"><\u002Fdiv>\n  <\u002Fdiv>\n  <div style=\"flex:1;min-height:0;background:#FFFFFF;border-radius:42px;overflow:hidden;position:relative;display:flex;flex-direction:column;\">\n\n    <sc-if value=\"{{ spinOn }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"position:absolute;inset:0;background:rgba(250,253,252,.94);border-radius:42px;z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;\">\n        <img src=\"1dcbc51e-6762-4e2d-b2bf-497dc267d691\" alt=\"\" style=\"width:58px;height:54px;object-fit:contain;\">\n        <div style=\"width:42px;height:42px;border:4px solid #D5EEEA;border-top-color:#32B1A5;border-right-color:#57C231;border-radius:50%;animation:spin .75s linear infinite;\"><\u002Fdiv>\n        <div style=\"font-size:13px;color:#1B3A6B;font-weight:800;\">{{ spinText }}<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ toastOn }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"position:absolute;left:50%;bottom:100px;transform:translateX(-50%);background:#14201F;color:#fff;font-size:12px;font-weight:700;padding:11px 18px;border-radius:22px;z-index:300;white-space:nowrap;animation:fadeUp .25s ease;\">{{ toastMsg }}<\u002Fdiv>\n    <\u002Fsc-if>\n\n    <div style=\"flex-shrink:0;background:linear-gradient(135deg,#003189,#0A47B8);color:rgba(255,255,255,.9);font-size:10px;font-family:Verdana,monospace;padding:7px 22px 5px;display:flex;justify-content:space-between;align-items:center;\">\n      <span>{{ hora }}<\u002Fspan><span>▲ ◈ 100%<\u002Fspan>\n    <\u002Fdiv>\n\n    <div style=\"flex:1;min-height:0;position:relative;display:flex;flex-direction:column;zoom:{{ fz }};\">\n\n      <!-- ══════════ PUBLICIDAD ══════════ -->\n      <sc-if value=\"{{ isAds }}\" hint-placeholder-val=\"{{ true }}\">\n        <div data-screen-label=\"Publicidad MinSalud\" style=\"position:absolute;inset:0;display:flex;flex-direction:column;background:#fff;\">\n          <div style=\"flex-shrink:0;display:flex;justify-content:space-between;align-items:center;padding:12px 16px 4px;\">\n            <div style=\"font-size:10px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.1em;\">Mensaje institucional<\u002Fdiv>\n            <button sc-camel-on-click=\"{{ skipAds }}\" style=\"border:1.5px solid #003189;background:#fff;color:#1B3A6B;font-family:'Nunito Sans',sans-serif;font-size:13px;font-weight:800;border-radius:20px;padding:8px 16px;cursor:pointer;min-height:40px;\" style-hover=\"border-color:#32B1A5;color:#1F8A80;\">Omitir ›<\u002Fbutton>\n          <\u002Fdiv>\n          <div style=\"flex:1;min-height:0;position:relative;\">\n            <sc-if value=\"{{ ad0 }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:20px 26px;animation:fadeUp .3s ease;\">\n                <img src=\"6c38fa02-21f8-4f5b-aecb-b4323e870b27\" alt=\"Ministerio de Salud\" style=\"width:150px;height:auto;\">\n                <svg sc-camel-view-box=\"0 0 300 140\" style=\"width:100%;max-width:280px;border-radius:14px;\" aria-label=\"pieza de campaña\">\n                  <defs><pattern id=\"st1\" width=\"10\" height=\"10\" sc-camel-pattern-transform=\"rotate(45)\" sc-camel-pattern-units=\"userSpaceOnUse\"><rect width=\"10\" height=\"10\" fill=\"#EAF6F4\"><\u002Frect><rect width=\"5\" height=\"10\" fill=\"#F5FBFA\"><\u002Frect><\u002Fpattern><\u002Fdefs>\n                  <rect width=\"300\" height=\"140\" rx=\"12\" fill=\"url(#st1)\" stroke=\"#CBE5E1\" stroke-width=\"1.5\"><\u002Frect>\n                  <text x=\"150\" y=\"65\" text-anchor=\"middle\" font-family=\"Verdana,monospace\" font-size=\"10\" fill=\"#5B6B69\">[ pieza gráfica de campaña ]<\u002Ftext>\n                  <text x=\"150\" y=\"83\" text-anchor=\"middle\" font-family=\"Verdana,monospace\" font-size=\"8\" fill=\"#8AA09D\">plantilla-redes-salud_v1.ai<\u002Ftext>\n                <\u002Fsvg>\n                <div style=\"text-align:center;\">\n                  <div style=\"font-size:19px;font-weight:900;color:#003189;line-height:1.25;\">La salud es un derecho<br>fundamental<\u002Fdiv>\n                  <div style=\"font-size:12px;color:#3D5A82;margin-top:6px;line-height:1.5;\">Ministerio de Salud y Protección Social<br>República de Colombia<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <sc-if value=\"{{ ad1 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:20px 26px;animation:fadeUp .3s ease;\">\n                <img src=\"b5af4583-3fe7-4e5f-92e2-32887fef8efb\" alt=\"ClicSalud\" style=\"width:120px;height:110px;object-fit:contain;\">\n                <div style=\"text-align:center;\">\n                  <div style=\"font-size:13px;font-weight:800;color:#003189;\">Clic<span style=\"color:#1F8A80;\">Salud<\u002Fspan> · Derechos y Deberes<\u002Fdiv>\n                  <div style=\"font-size:19px;font-weight:900;color:#003189;line-height:1.25;margin-top:4px;\">Conozca sus derechos<br>y deberes en salud<\u002Fdiv>\n                  <div style=\"font-size:12px;color:#3D5A82;margin-top:6px;line-height:1.5;\">La Carta de Derechos y Deberes de su EPS,<br>en lenguaje claro y siempre a la mano.<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <sc-if value=\"{{ ad2 }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:20px 26px;animation:fadeUp .3s ease;\">\n                <img src=\"1dcbc51e-6762-4e2d-b2bf-497dc267d691\" alt=\"ClicSalud\" style=\"width:120px;height:110px;object-fit:contain;\">\n                <div style=\"text-align:center;\">\n                  <div style=\"font-size:13px;font-weight:800;color:#003189;\">Clic<span style=\"color:#1F8A80;\">Salud<\u002Fspan> · Encuesta ENUS<\u002Fdiv>\n                  <div style=\"font-size:19px;font-weight:900;color:#003189;line-height:1.25;margin-top:4px;\">Su voz mejora el<br>sistema de salud<\u002Fdiv>\n                  <div style=\"font-size:12px;color:#3D5A82;margin-top:6px;line-height:1.5;\">Responda la Encuesta Nacional de Experiencia<br>del Usuario en Salud — ENUS 2026.<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n          <div style=\"flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:10px 18px 22px;gap:12px;\">\n            <button sc-camel-on-click=\"{{ prevAd }}\" style=\"width:48px;height:48px;border-radius:50%;border:1.5px solid #003189;background:#fff;color:#1B3A6B;font-size:18px;cursor:pointer;\" style-hover=\"border-color:#32B1A5;\">‹<\u002Fbutton>\n            <div style=\"display:flex;gap:6px;\">\n              <sc-for list=\"{{ adDots }}\" as=\"dot\" hint-placeholder-count=\"3\">\n                <div style=\"width:{{ dot.w }};height:8px;border-radius:4px;background:{{ dot.bg }};transition:all .25s;\"><\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n            <sc-if value=\"{{ adLast }}\" hint-placeholder-val=\"{{ false }}\">\n              <button sc-camel-on-click=\"{{ skipAds }}\" style=\"height:48px;border-radius:24px;border:none;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;font-family:'Nunito Sans',sans-serif;font-size:15px;font-weight:900;padding:0 22px;cursor:pointer;box-shadow:0 4px 12px rgba(50,177,165,.35);\">Comenzar<\u002Fbutton>\n            <\u002Fsc-if>\n            <sc-if value=\"{{ adNotLast }}\" hint-placeholder-val=\"{{ true }}\">\n              <button sc-camel-on-click=\"{{ nextAd }}\" style=\"width:48px;height:48px;border-radius:50%;border:none;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;font-size:18px;cursor:pointer;box-shadow:0 4px 12px rgba(50,177,165,.35);\">›<\u002Fbutton>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- ══════════ SESIÓN GUARDADA — REINGRESO ══════════ -->\n      <sc-if value=\"{{ isResume }}\" hint-placeholder-val=\"{{ false }}\">\n        <div data-screen-label=\"Reingreso\" style=\"position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;background:linear-gradient(180deg,#fff,#F0FAF7 60%,#EAF0FA);padding:26px;\">\n          <div style=\"background:#fff;border-radius:10px;padding:6px 12px;box-shadow:0 2px 8px rgba(0,60,80,.08);\"><img src=\"6c38fa02-21f8-4f5b-aecb-b4323e870b27\" alt=\"MinSalud\" style=\"height:34px;display:block;\"><\u002Fdiv>\n          <div style=\"width:76px;height:76px;border-radius:50%;background:linear-gradient(135deg,#E4F5F2,#D2EFEA);display:flex;align-items:center;justify-content:center;\">\n            <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:38px;height:38px;\" fill=\"#32B1A5\"><path d=\"M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z\"><\u002Fpath><\u002Fsvg>\n          <\u002Fdiv>\n          <div style=\"text-align:center;\">\n            <div style=\"font-size:14px;color:#3D5A82;font-weight:700;\">Hola de nuevo<\u002Fdiv>\n            <div style=\"font-size:20px;font-weight:900;color:#003189;margin-top:2px;\">{{ sesNombre }}<\u002Fdiv>\n            <div style=\"font-size:12px;color:#3D5A82;margin-top:4px;\">{{ sesEps }} · {{ sesTipo }}<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"font-size:11.5px;color:#3D5A82;text-align:center;line-height:1.6;background:#fff;border-radius:12px;padding:10px 14px;border:1.5px solid #003189;\">Su sesión quedó guardada en este teléfono.<br>No necesita identificarse otra vez.<\u002Fdiv>\n          <button sc-camel-on-click=\"{{ resumeSes }}\" style=\"width:100%;border:none;border-radius:14px;padding:17px;font-family:'Nunito Sans',sans-serif;font-size:16px;font-weight:900;cursor:pointer;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;box-shadow:0 5px 16px rgba(50,177,165,.32);\">Continuar como {{ sesPrimerNombre }} →<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ logout }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:12px;padding:13px;background:#fff;font-family:'Nunito Sans',sans-serif;font-size:13px;font-weight:800;color:#1B3A6B;cursor:pointer;\" style-hover=\"border-color:#32B1A5;\">No soy yo · Cambiar de usuario<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- ══════════ IDENTIFICACIÓN ══════════ -->\n      <sc-if value=\"{{ isId }}\" hint-placeholder-val=\"{{ false }}\">\n        <div data-screen-label=\"Identificación\" style=\"position:absolute;inset:0;display:flex;flex-direction:column;background:#F2F6F5;\">\n          <div style=\"flex-shrink:0;background:linear-gradient(135deg,#003189,#0A47B8);padding:14px 16px 16px;\">\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px;\">\n              <div style=\"background:#fff;border-radius:8px;padding:4px 9px;\"><img src=\"6c38fa02-21f8-4f5b-aecb-b4323e870b27\" alt=\"MinSalud\" style=\"height:28px;display:block;\"><\u002Fdiv>\n              <div style=\"font-size:9px;color:rgba(255,255,255,.78);font-weight:700;line-height:1.35;\">Ministerio de Salud<br>y Protección Social<\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"font-size:18px;font-weight:900;color:#fff;\">Identifíquese<\u002Fdiv>\n            <div style=\"font-size:12px;color:rgba(255,255,255,.8);margin-top:3px;line-height:1.45;\">Paso 1 de 3 · Solo necesita su documento.<br>Se identifica una sola vez para toda la aplicación.<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"flex:1;min-height:0;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:11px;\">\n            <div style=\"background:#fff;border-radius:14px;padding:14px;border:1.5px solid #003189;\">\n              <div style=\"font-size:11px;font-weight:800;color:#1B3A6B;margin-bottom:7px;\">Tipo de documento<\u002Fdiv>\n              <sc-raw-select value=\"{{ tipoDoc }}\" sc-camel-on-change=\"{{ onTipoDoc }}\" style=\"width:100%;appearance:none;background:#EEF6F5;border:2px solid #003189;border-radius:10px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;font-size:14px;font-weight:700;color:#003189;outline:none;cursor:pointer;min-height:48px;\">\n                <option value=\"CC\">Cédula de Ciudadanía<\u002Foption>\n                <option value=\"TI\">Tarjeta de Identidad<\u002Foption>\n                <option value=\"CE\">Cédula de Extranjería<\u002Foption>\n                <option value=\"PA\">Pasaporte<\u002Foption>\n                <option value=\"PT\">Permiso por Protección Temporal<\u002Foption>\n              <\u002Fsc-raw-select>\n            <\u002Fdiv>\n            <div style=\"background:#fff;border-radius:14px;padding:14px;border:1.5px solid #003189;\">\n              <div style=\"font-size:11px;font-weight:800;color:#1B3A6B;margin-bottom:7px;\">Número de documento<\u002Fdiv>\n              <input type=\"tel\" value=\"{{ cedula }}\" sc-camel-on-change=\"{{ onCedula }}\" placeholder=\"Escriba su número aquí\" sc-camel-max-length=\"12\" style=\"width:100%;background:#EEF6F5;border:2px solid {{ ccBorder }};border-radius:10px;padding:14px;font-family:Verdana,monospace;font-size:19px;font-weight:500;color:#003189;outline:none;min-height:52px;\">\n              <div style=\"font-size:11px;color:#3D5A82;margin-top:5px;\">Solo números · Sin puntos ni guiones<\u002Fdiv>\n              <sc-if value=\"{{ ccErr }}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"font-size:12px;color:#C62828;margin-top:4px;font-weight:800;\">⚠ Escriba mínimo 7 números<\u002Fdiv>\n              <\u002Fsc-if>\n            <\u002Fdiv>\n            <button sc-camel-on-click=\"{{ submitId }}\" style=\"width:100%;border:none;border-radius:14px;padding:17px;font-family:'Nunito Sans',sans-serif;font-size:16px;font-weight:900;cursor:pointer;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;box-shadow:0 4px 14px rgba(50,177,165,.32);\" style-hover=\"filter:brightness(1.05);\">Continuar →<\u002Fbutton>\n            <div style=\"background:#fff;border-radius:10px;padding:10px 13px;border:1.5px solid #003189;\">\n              <div style=\"font-size:10px;color:#3D5A82;line-height:1.65;\"><strong style=\"color:#003189;\">Demo contributivo:<\u002Fstrong> 1020304050 · 79456123 · 1193012345<br><strong style=\"color:#003189;\">Subsidiado:<\u002Fstrong> 1073512836 · 43215678 &nbsp;·&nbsp; Sin atenciones: 11111111<br>No afiliado: 99999999<\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:flex;gap:8px;align-items:flex-start;background:#EAF3FF;border-radius:10px;padding:10px 12px;\">\n              <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:15px;height:15px;flex-shrink:0;margin-top:1px;\" fill=\"#003189\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z\"><\u002Fpath><\u002Fsvg>\n              <div style=\"font-size:10.5px;color:#003189;line-height:1.5;\">Sus datos se usan solo para verificación. Tratamiento conforme a la Ley 1581 de 2012 — Habeas Data.<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- ══════════ OTP ══════════ -->\n      <sc-if value=\"{{ isOtp }}\" hint-placeholder-val=\"{{ false }}\">\n        <div data-screen-label=\"Código SMS\" style=\"position:absolute;inset:0;display:flex;flex-direction:column;background:#F2F6F5;\">\n          <div style=\"flex-shrink:0;background:linear-gradient(135deg,#003189,#0A47B8);padding:14px 16px 16px;\">\n            <div style=\"font-size:18px;font-weight:900;color:#fff;\">Código de verificación<\u002Fdiv>\n            <div style=\"font-size:12px;color:rgba(255,255,255,.8);margin-top:3px;\">Paso 2 de 3 · Le enviamos 4 números por mensaje de texto<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"flex:1;min-height:0;overflow-y:auto;padding:18px 16px;display:flex;flex-direction:column;align-items:center;gap:14px;\">\n            <div style=\"display:flex;gap:9px;cursor:text;\" sc-camel-on-click=\"{{ focusOtp }}\">\n              <sc-for list=\"{{ otpBoxes }}\" as=\"b\" hint-placeholder-count=\"4\">\n                <div style=\"width:58px;height:66px;border-radius:12px;border:2px solid {{ b.bc }};background:#fff;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:900;font-family:Verdana,monospace;color:#1F8A80;\">{{ b.d }}<\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n            <input ref=\"{{ otpRef }}\" type=\"tel\" value=\"{{ otpVal }}\" sc-camel-on-change=\"{{ onOtp }}\" sc-camel-max-length=\"4\" sc-camel-auto-complete=\"one-time-code\" style=\"position:absolute;opacity:0;width:1px;height:1px;left:-9999px;\">\n            <sc-if value=\"{{ otpErr }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"font-size:13px;color:#C62828;font-weight:800;\">El código no coincide. Intente de nuevo.<\u002Fdiv>\n            <\u002Fsc-if>\n            <div style=\"background:linear-gradient(135deg,#E8F7F4,#EDFAF0);border-radius:10px;padding:10px 15px;\">\n              <div style=\"font-size:12px;color:#1F6E56;font-weight:700;\">Código de demostración: <span style=\"font-family:Verdana,monospace;font-size:15px;font-weight:900;\">{{ otpCode }}<\u002Fspan><\u002Fdiv>\n            <\u002Fdiv>\n            <button sc-camel-on-click=\"{{ confirmOtp }}\" style=\"width:100%;border:none;border-radius:14px;padding:16px;font-family:'Nunito Sans',sans-serif;font-size:15px;font-weight:900;cursor:pointer;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;box-shadow:0 4px 14px rgba(50,177,165,.32);\">Confirmar código →<\u002Fbutton>\n            <button sc-camel-on-click=\"{{ backToId }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:12px;padding:13px;background:#fff;font-family:'Nunito Sans',sans-serif;font-size:13px;font-weight:800;color:#1B3A6B;cursor:pointer;\" style-hover=\"border-color:#32B1A5;\">← Volver<\u002Fbutton>\n            <div style=\"background:#fff;border-radius:12px;border-left:4px solid #003189;padding:12px 13px;display:flex;gap:10px;align-items:flex-start;width:100%;\">\n              <div style=\"width:30px;height:30px;border-radius:50%;background:#003189;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;font-weight:900;color:#fff;\">?<\u002Fdiv>\n              <div>\n                <div style=\"font-size:13px;font-weight:800;color:#003189;\">¿No tiene celular?<\u002Fdiv>\n                <div style=\"font-size:11.5px;color:#3D5A82;line-height:1.5;\">Un funcionario puede asistirle con la tableta institucional del punto de atención de su EPS.<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- ══════════ VERIFICACIÓN BDUA ══════════ -->\n      <sc-if value=\"{{ isVerify }}\" hint-placeholder-val=\"{{ false }}\">\n        <div data-screen-label=\"Verificación BDUA\" style=\"position:absolute;inset:0;display:flex;flex-direction:column;background:#F2F6F5;\">\n          <div style=\"flex-shrink:0;background:linear-gradient(135deg,#003189,#0A47B8);padding:14px 16px 16px;\">\n            <div style=\"font-size:18px;font-weight:900;color:#fff;\">{{ verTitle }}<\u002Fdiv>\n            <div style=\"font-size:12px;color:rgba(255,255,255,.8);margin-top:3px;\">{{ verSub }}<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"flex:1;min-height:0;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:11px;\">\n            <sc-if value=\"{{ notFound }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;align-items:center;gap:12px;padding-top:8px;\">\n                <div style=\"width:60px;height:60px;border-radius:18px;background:linear-gradient(135deg,#FF6B35,#E53935);display:flex;align-items:center;justify-content:center;\">\n                  <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:30px;height:30px;\" fill=\"#fff\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"><\u002Fpath><\u002Fsvg>\n                <\u002Fdiv>\n                <div style=\"font-size:17px;font-weight:900;color:#003189;text-align:center;\">No encontramos su documento<br>en la base de afiliados (BDUA)<\u002Fdiv>\n                <div style=\"font-size:12.5px;color:#3D5A82;text-align:center;line-height:1.6;\">El número <strong>{{ cedula }}<\u002Fstrong> no aparece con estado ACTIVO.<br>Sin afiliación activa no es posible entrar a los módulos.<\u002Fdiv>\n                <div style=\"width:100%;background:#fff;border-radius:14px;padding:14px;border:1.5px solid #003189;\">\n                  <div style=\"font-size:13px;font-weight:900;color:#003189;margin-bottom:10px;\">¿Cómo puede afiliarse o activar su afiliación?<\u002Fdiv>\n                  <div style=\"display:flex;flex-direction:column;gap:10px;\">\n                    <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n                      <div style=\"width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,#32B1A5,#57C231);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:900;color:#fff;\">1<\u002Fdiv>\n                      <div style=\"font-size:12px;color:#1B3A6B;line-height:1.5;\">Acérquese a la <strong>EPS de su preferencia<\u002Fstrong> con su documento de identidad. La afiliación es gratuita.<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n                      <div style=\"width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,#32B1A5,#57C231);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:900;color:#fff;\">2<\u002Fdiv>\n                      <div style=\"font-size:12px;color:#1B3A6B;line-height:1.5;\">O afíliese en línea en <strong>www.miseguridadsocial.gov.co<\u002Fstrong>, el portal del Gobierno.<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n                      <div style=\"width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,#32B1A5,#57C231);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:900;color:#fff;\">3<\u002Fdiv>\n                      <div style=\"font-size:12px;color:#1B3A6B;line-height:1.5;\">Si cree que es un error, llame gratis a la <strong>Línea 192<\u002Fstrong> del Ministerio de Salud.<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"width:100%;background:#fff;border-radius:14px;padding:14px;border:1.5px solid #003189;\">\n                  <div style=\"font-size:13px;font-weight:900;color:#003189;margin-bottom:3px;\">Mientras tanto, puede consultar:<\u002Fdiv>\n                  <div style=\"font-size:11px;color:#3D5A82;line-height:1.5;margin-bottom:11px;\">Compare las EPS y conozca sus derechos para elegir bien al afiliarse.<\u002Fdiv>\n                  <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                    <button sc-camel-on-click=\"{{ guestGoDes }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:13px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:11px;text-align:left;min-height:60px;\" style-hover=\"background:#EAF0FA;\">\n                      <div style=\"width:34px;height:30px;background:#EAF0FA;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg sc-camel-view-box=\"0 0 24 24\" style=\"width:17px;height:17px;\" fill=\"#003189\"><path d=\"M5 9h3v11H5zM10.5 4h3v16h-3zM16 13h3v7h-3z\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n                      <div style=\"flex:1;\"><div style=\"font-size:13px;font-weight:900;\">Comparar las EPS<\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;\">Carta de Desempeño · elija su mejor opción<\u002Fdiv><\u002Fdiv>\n                      <span style=\"color:#003189;\">›<\u002Fspan>\n                    <\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ guestGoDer }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:13px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:11px;text-align:left;min-height:60px;\" style-hover=\"background:#EAF0FA;\">\n                      <img src=\"b5af4583-3fe7-4e5f-92e2-32887fef8efb\" alt=\"\" style=\"width:34px;height:30px;object-fit:contain;background:#fff;border-radius:9px;padding:3px;flex-shrink:0;\">\n                      <div style=\"flex:1;\"><div style=\"font-size:13px;font-weight:900;\">Conocer sus derechos y deberes<\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;\">Por qué es importante estar afiliado<\u002Fdiv><\u002Fdiv>\n                      <span style=\"color:#003189;\">›<\u002Fspan>\n                    <\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <button sc-camel-on-click=\"{{ backToId }}\" style=\"width:100%;border:none;border-radius:14px;padding:16px;background:linear-gradient(135deg,#32B1A5,#57C231);font-family:'Nunito Sans',sans-serif;font-size:15px;font-weight:900;color:#fff;cursor:pointer;box-shadow:0 4px 14px rgba(50,177,165,.32);\">Intentar con otro documento<\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <sc-if value=\"{{ found }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(0,60,80,.07);\">\n                <div style=\"height:4px;background:linear-gradient(135deg,#32B1A5,#57C231);\"><\u002Fdiv>\n                <div style=\"padding:13px;\">\n                  <div style=\"display:flex;align-items:center;gap:11px;margin-bottom:11px;\">\n                    <div style=\"width:42px;height:42px;border-radius:11px;background:linear-gradient(135deg,#E4F5F2,#D2EFEA);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                      <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:22px;height:22px;\" fill=\"#32B1A5\"><path d=\"M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z\"><\u002Fpath><\u002Fsvg>\n                    <\u002Fdiv>\n                    <div style=\"flex:1;min-width:0;\">\n                      <div style=\"font-size:14.5px;font-weight:800;color:#003189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ sesNombre }}<\u002Fdiv>\n                      <div style=\"font-size:11px;color:#3D5A82;\">{{ cedula }} · {{ sesTipo }}<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#32B1A5,#57C231);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                      <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:14px;height:14px;\" fill=\"#fff\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"><\u002Fpath><\u002Fsvg>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:7px;\">\n                    <div style=\"background:#fff;border:1.5px solid #003189;border-radius:9px;padding:8px 10px;\"><div style=\"font-size:9px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.06em;\">EPS<\u002Fdiv><div style=\"font-size:12px;font-weight:700;color:#003189;\">{{ sesEps }}<\u002Fdiv><\u002Fdiv>\n                    <div style=\"background:#fff;border:1.5px solid #003189;border-radius:9px;padding:8px 10px;\"><div style=\"font-size:9px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.06em;\">Régimen<\u002Fdiv><div style=\"font-size:12px;font-weight:700;color:#003189;\">{{ sesTipo }}<\u002Fdiv><\u002Fdiv>\n                    <div style=\"background:#fff;border:1.5px solid #003189;border-radius:9px;padding:8px 10px;\"><div style=\"font-size:9px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.06em;\">Municipio<\u002Fdiv><div style=\"font-size:12px;font-weight:700;color:#003189;\">{{ sesMun }}<\u002Fdiv><\u002Fdiv>\n                    <div style=\"background:#fff;border:1.5px solid #003189;border-radius:9px;padding:8px 10px;\"><div style=\"font-size:9px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.06em;\">Departamento<\u002Fdiv><div style=\"font-size:12px;font-weight:700;color:#003189;\">{{ sesDpto }}<\u002Fdiv><\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"background:linear-gradient(135deg,#E9FBF1,#E4F8F1);border:1.5px solid #A8E6C4;border-radius:11px;padding:10px 12px;display:flex;align-items:center;gap:9px;\">\n                <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:20px;height:20px;flex-shrink:0;\" fill=\"#1F8A5E\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z\"><\u002Fpath><\u002Fsvg>\n                <div style=\"font-size:11.5px;font-weight:700;color:#1F6E4A;line-height:1.45;\">Afiliado <strong>ACTIVO<\u002Fstrong> en BDUA · {{ fecha }}<\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"background:#fff;border-radius:11px;padding:10px 13px;border:1.5px solid #003189;\">\n                <div style=\"font-size:11px;color:#3D5A82;line-height:1.6;\">Al confirmar, su sesión queda <strong style=\"color:#003189;\">guardada en este teléfono<\u002Fstrong>: la próxima vez que abra la aplicación no tendrá que identificarse de nuevo.<\u002Fdiv>\n              <\u002Fdiv>\n              <button sc-camel-on-click=\"{{ confirmVerify }}\" style=\"width:100%;border:none;border-radius:14px;padding:17px;font-family:'Nunito Sans',sans-serif;font-size:16px;font-weight:900;cursor:pointer;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;box-shadow:0 4px 14px rgba(50,177,165,.32);\">Sí, soy yo — Entrar →<\u002Fbutton>\n              <button sc-camel-on-click=\"{{ backToId }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:12px;padding:13px;background:#fff;font-family:'Nunito Sans',sans-serif;font-size:13px;font-weight:800;color:#1B3A6B;cursor:pointer;\">← Cambiar documento<\u002Fbutton>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- ══════════ TABS ══════════ -->\n      <sc-if value=\"{{ isTabs }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"position:absolute;inset:0;display:flex;flex-direction:column;\">\n          <div style=\"flex:1;min-height:0;position:relative;\">\n\n            <!-- ── INICIO ── -->\n            <sc-if value=\"{{ tabIni }}\" hint-placeholder-val=\"{{ true }}\">\n              <div data-screen-label=\"Inicio\" style=\"position:absolute;inset:0;overflow-y:auto;background:#F2F6F5;\">\n                <div style=\"background:linear-gradient(135deg,#003189,#0A47B8);padding:14px 16px 20px;\">\n                  <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;\">\n                    <div style=\"background:#fff;border-radius:8px;padding:4px 9px;\"><img src=\"6c38fa02-21f8-4f5b-aecb-b4323e870b27\" alt=\"MinSalud\" style=\"height:26px;display:block;\"><\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ logout }}\" style=\"border:1.5px solid rgba(255,255,255,.35);background:none;color:#fff;font-family:'Nunito Sans',sans-serif;font-size:11px;font-weight:800;border-radius:16px;padding:7px 13px;cursor:pointer;\" style-hover=\"background:rgba(255,255,255,.12);\">{{ logoutLbl }}<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"font-size:13px;color:rgba(255,255,255,.8);font-weight:600;\">{{ saludo }}<\u002Fdiv>\n                  <div style=\"font-size:22px;font-weight:900;color:#fff;line-height:1.15;\">{{ iniNombre }}<\u002Fdiv>\n                  <div style=\"display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.14);border-radius:16px;padding:5px 12px;margin-top:8px;\">\n                    <div style=\"width:7px;height:7px;border-radius:50%;background:{{ iniDotC }};\"><\u002Fdiv>\n                    <div style=\"font-size:11px;color:#fff;font-weight:700;\">{{ iniChip }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"padding:14px 14px 22px;display:flex;flex-direction:column;gap:11px;\">\n                  <div style=\"font-size:14px;font-weight:900;color:#003189;\">¿Qué desea hacer hoy?<\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ setTabDer }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:16px;padding:15px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:13px;text-align:left;min-height:76px;\" style-hover=\"background:#EAF0FA;\">\n                    <img src=\"b5af4583-3fe7-4e5f-92e2-32887fef8efb\" alt=\"\" style=\"width:44px;height:40px;object-fit:contain;background:#fff;border-radius:11px;padding:4px;flex-shrink:0;\">\n                    <div style=\"flex:1;\"><div style=\"font-size:15px;font-weight:900;\">Mis derechos y deberes<\u002Fdiv><div style=\"font-size:11.5px;color:#3D5A82;line-height:1.4;\">Conozca lo que su EPS debe garantizarle<\u002Fdiv><\u002Fdiv>\n                    <span style=\"font-size:18px;color:#003189;\">›<\u002Fspan>\n                  <\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ setTabDes }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:16px;padding:15px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:13px;text-align:left;min-height:76px;\" style-hover=\"background:#EAF0FA;\">\n                    <div style=\"width:44px;height:40px;background:#EAF0FA;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg sc-camel-view-box=\"0 0 24 24\" style=\"width:22px;height:22px;\" fill=\"#003189\"><path d=\"M5 9h3v11H5zM10.5 4h3v16h-3zM16 13h3v7h-3z\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n                    <div style=\"flex:1;\"><div style=\"font-size:15px;font-weight:900;\">¿Cómo va mi EPS?<\u002Fdiv><div style=\"font-size:11.5px;color:#3D5A82;line-height:1.4;\">Carta de Desempeño · calidad de su EPS<\u002Fdiv><\u002Fdiv>\n                    <span style=\"font-size:18px;color:#003189;\">›<\u002Fspan>\n                  <\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ setTabEnc }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:16px;padding:15px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:13px;text-align:left;min-height:76px;\" style-hover=\"background:#EAF0FA;\">\n                    <img src=\"1dcbc51e-6762-4e2d-b2bf-497dc267d691\" alt=\"\" style=\"width:44px;height:40px;object-fit:contain;background:#fff;border-radius:11px;padding:4px;flex-shrink:0;\">\n                    <div style=\"flex:1;\"><div style=\"font-size:15px;font-weight:900;\">Contar mi experiencia<\u002Fdiv><div style=\"font-size:11.5px;color:#3D5A82;line-height:1.4;\">Encuesta de satisfacción · ~5 minutos<\u002Fdiv><\u002Fdiv>\n                    <span style=\"font-size:18px;color:#003189;\">›<\u002Fspan>\n                  <\u002Fbutton>\n                  <div style=\"background:#fff;border-radius:14px;padding:13px 14px;border:1.5px solid #003189;display:flex;align-items:center;gap:12px;\">\n                    <div style=\"flex:1;\">\n                      <div style=\"font-size:13px;font-weight:900;color:#003189;\">Tamaño de la letra<\u002Fdiv>\n                      <div style=\"font-size:10.5px;color:#3D5A82;\">Elija el que le resulte más cómodo<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;background:#F2F6F5;border-radius:10px;padding:3px;\">\n                      <button sc-camel-on-click=\"{{ fzNormal }}\" style=\"border:none;border-radius:8px;padding:9px 14px;font-family:'Nunito Sans',sans-serif;font-size:12px;font-weight:800;cursor:pointer;background:{{ fzNBg }};color:{{ fzNFc }};min-height:40px;\">Aa<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ fzGrande }}\" style=\"border:none;border-radius:8px;padding:9px 14px;font-family:'Nunito Sans',sans-serif;font-size:16px;font-weight:900;cursor:pointer;background:{{ fzGBg }};color:{{ fzGFc }};min-height:40px;\">Aa<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"background:#fff;border-radius:11px;padding:10px 13px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:10.5px;color:#3D5A82;line-height:1.6;\">Aplicación oficial del <strong style=\"color:#003189;\">Ministerio de Salud y Protección Social<\u002Fstrong> · Resolución 2026 · Línea gratuita de orientación: <strong style=\"color:#003189;\">192<\u002Fstrong><\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <!-- ── DERECHOS ── -->\n            <sc-if value=\"{{ tabDer }}\" hint-placeholder-val=\"{{ false }}\">\n              <div data-screen-label=\"Módulo Derechos y Deberes\" style=\"position:absolute;inset:0;overflow-y:auto;background:#F2F6F5;\">\n                <div style=\"background:linear-gradient(135deg,#003189,#0A47B8);padding:14px 16px 18px;\">\n                  <div style=\"display:flex;align-items:center;gap:11px;\">\n                    <div style=\"width:48px;height:48px;border-radius:13px;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                      <img src=\"b5af4583-3fe7-4e5f-92e2-32887fef8efb\" alt=\"\" style=\"width:40px;height:36px;object-fit:contain;\">\n                    <\u002Fdiv>\n                    <div>\n                      <div style=\"font-size:17px;font-weight:900;color:#fff;\">Clic<span style=\"color:#7FE0C8;\">Salud<\u002Fspan><\u002Fdiv>\n                      <div style=\"font-size:11px;color:rgba(255,255,255,.75);\">Carta de Derechos y Deberes · Sentencia T-760/2008<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"padding:13px 13px 20px;display:flex;flex-direction:column;gap:15px;\">\n                  <sc-if value=\"{{ isGuest }}\" hint-placeholder-val=\"{{ false }}\">\n                    <div style=\"background:linear-gradient(135deg,#FFF6E8,#FFF9F0);border:1.5px solid #F2D9A6;border-radius:12px;padding:12px 14px;\">\n                      <div style=\"font-size:12.5px;font-weight:900;color:#8A5A00;margin-bottom:3px;\">¿Por qué es importante afiliarse?<\u002Fdiv>\n                      <div style=\"font-size:11px;color:#7A5A20;line-height:1.55;\">Al afiliarse, todos estos derechos quedan garantizados para usted y su familia: atención sin barreras, urgencias en cualquier IPS y protección especial. Conózcalos aquí.<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fsc-if>\n                  <div>\n                    <div style=\"display:flex;align-items:baseline;justify-content:space-between;margin-bottom:9px;\">\n                      <div style=\"font-size:14px;font-weight:900;color:#003189;\">Aprenda sus derechos<\u002Fdiv>\n                      <div style=\"font-size:10px;color:#3D5A82;font-weight:700;\">Tarjetas rápidas<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:9px;\">\n                      <sc-for list=\"{{ decksV }}\" as=\"dk\" hint-placeholder-count=\"5\">\n                        <button sc-camel-on-click=\"{{ dk.open }}\" style=\"border:none;text-align:left;background:#fff;border:1.5px solid #003189;border-radius:14px;padding:13px 12px;cursor:pointer;display:flex;flex-direction:column;gap:7px;min-height:104px;font-family:'Nunito Sans',sans-serif;\" style-hover=\"background:#EAF0FA;\">\n                          <div style=\"width:28px;height:28px;border-radius:9px;background:#003189;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;color:#fff;\">{{ dk.num }}<\u002Fdiv>\n                          <div style=\"font-size:13px;font-weight:900;color:#003189;line-height:1.2;\">{{ dk.titulo }}<\u002Fdiv>\n                          <div style=\"font-size:9.5px;color:#3D5A82;font-weight:700;\">{{ dk.count }} tarjetas · {{ dk.sub }}<\u002Fdiv>\n                        <\u002Fbutton>\n                      <\u002Fsc-for>\n                      <button sc-camel-on-click=\"{{ openVer }}\" style=\"border:1.5px solid #003189;text-align:left;background:#fff;border-radius:14px;padding:13px 12px;cursor:pointer;display:flex;flex-direction:column;gap:7px;min-height:104px;font-family:'Nunito Sans',sans-serif;\" style-hover=\"background:#EAF0FA;\">\n                        <div style=\"width:28px;height:28px;border-radius:9px;background:#003189;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg sc-camel-view-box=\"0 0 24 24\" style=\"width:15px;height:15px;\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 11l3 3 6-6\"><\u002Fpath><path d=\"M21 12a9 9 0 1 1-4.2-7.6\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n                        <div style=\"font-size:13px;font-weight:900;color:#003189;line-height:1.2;\">Encuesta de verificación<\u002Fdiv>\n                        <div style=\"font-size:9.5px;color:#3D5A82;font-weight:700;\">10 preguntas · Art. 5 y 6<\u002Fdiv>\n                      <\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div>\n                    <div style=\"display:flex;align-items:baseline;justify-content:space-between;margin-bottom:9px;\">\n                      <div style=\"font-size:14px;font-weight:900;color:#003189;\">Cartas por EPS<\u002Fdiv>\n                      <div style=\"font-size:10px;color:#3D5A82;font-weight:700;\">{{ epsCount }} EPS<\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"background:#fff;border:1.5px solid #003189;border-radius:14px;padding:14px;\">\n                      <div style=\"font-size:11px;font-weight:800;color:#003189;margin-bottom:7px;\">Seleccione su EPS<\u002Fdiv>\n                      <sc-raw-select value=\"{{ epsSel }}\" sc-camel-on-change=\"{{ onEpsSel }}\" style=\"width:100%;appearance:none;background:#fff;border:2px solid #003189;border-radius:10px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;font-size:14px;font-weight:700;color:#003189;outline:none;cursor:pointer;min-height:48px;\">\n                        <option value=\"\">— Elija una EPS de la lista —<\u002Foption>\n                        <sc-for list=\"{{ epsOpts }}\" as=\"o\" hint-placeholder-count=\"7\">\n                          <option value=\"{{ o.n }}\">{{ o.n }}<\u002Foption>\n                        <\u002Fsc-for>\n                      <\u002Fsc-raw-select>\n                      <sc-if value=\"{{ epsPicked }}\" hint-placeholder-val=\"{{ false }}\">\n                        <div style=\"margin-top:12px;border-top:1.5px solid #003189;padding-top:12px;\">\n                          <div style=\"font-size:14px;font-weight:900;color:#003189;\">{{ epsNombre }}<\u002Fdiv>\n                          <div style=\"font-size:10.5px;color:#3D5A82;margin-top:2px;\">{{ epsReg }} · {{ epsAf }} afiliados · Carta vigencia {{ epsV }}<\u002Fdiv>\n                          <a href=\"{{ epsUrl }}\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;gap:10px;margin-top:11px;border:1.5px solid #003189;border-radius:11px;padding:12px 13px;text-decoration:none;min-height:52px;\" style-hover=\"background:#EAF0FA;\">\n                            <div style=\"width:32px;height:32px;border-radius:9px;background:#EAF0FA;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg sc-camel-view-box=\"0 0 24 24\" style=\"width:17px;height:17px;\" fill=\"none\" stroke=\"#003189\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 3h7v7\"><\u002Fpath><path d=\"M21 3l-9 9\"><\u002Fpath><path d=\"M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n                            <div style=\"flex:1;min-width:0;\">\n                              <div style=\"font-size:12.5px;font-weight:900;color:#003189;\">Ver la Carta en el sitio de la EPS<\u002Fdiv>\n                              <div style=\"font-size:10px;color:#3D5A82;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ epsUrlCorta }}<\u002Fdiv>\n                            <\u002Fdiv>\n                            <span style=\"color:#003189;\">›<\u002Fspan>\n                          <\u002Fa>\n                        <\u002Fdiv>\n                      <\u002Fsc-if>\n                      <sc-if value=\"{{ epsNotPicked }}\" hint-placeholder-val=\"{{ true }}\">\n                        <div style=\"font-size:10.5px;color:#3D5A82;line-height:1.55;margin-top:9px;\">Elija una EPS para ver su Carta de Derechos y Deberes en el sitio oficial.<\u002Fdiv>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"background:#fff;border-radius:11px;padding:11px 13px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:10.5px;color:#3D5A82;line-height:1.6;\"><strong style=\"color:#003189;\">Base legal:<\u002Fstrong> la entrega de la Carta de Derechos y Deberes es obligatoria y universal para todas las EPS (Sentencia T-760/2008, orden 28 · Ley 1751/2015 · Resolución MSPS 2026).<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <!-- ── ENCUESTA DE VERIFICACIÓN (art. 5 y 6) ── -->\n            <sc-if value=\"{{ verOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div data-screen-label=\"Encuesta de verificación\" style=\"position:absolute;inset:0;z-index:50;display:flex;flex-direction:column;background:#fff;\">\n                <div style=\"flex-shrink:0;background:#fff;border-bottom:1.5px solid #003189;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:10px;\">\n                  <div style=\"min-width:0;\">\n                    <div style=\"font-size:14.5px;font-weight:900;color:#003189;\">Encuesta de verificación<\u002Fdiv>\n                    <div style=\"font-size:10px;color:#3D5A82;font-weight:700;\">Cartas de Derechos y de Desempeño · Art. 5 y 6<\u002Fdiv>\n                  <\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ closeVer }}\" style=\"width:40px;height:40px;border-radius:50%;border:1.5px solid #003189;background:#fff;color:#003189;font-size:15px;cursor:pointer;font-weight:800;flex-shrink:0;\" style-hover=\"background:#EAF0FA;\">✕<\u002Fbutton>\n                <\u002Fdiv>\n                <sc-if value=\"{{ verFin }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"flex:1;min-height:0;overflow-y:auto;padding:20px 15px;display:flex;flex-direction:column;align-items:center;gap:14px;\">\n                    <div style=\"width:60px;height:60px;border-radius:50%;border:2px solid #003189;background:#fff;display:flex;align-items:center;justify-content:center;animation:popIn .5s cubic-bezier(.34,1.56,.64,1);\">\n                      <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:29px;height:29px;\" fill=\"#003189\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"><\u002Fpath><\u002Fsvg>\n                    <\u002Fdiv>\n                    <div style=\"font-size:19px;font-weight:900;color:#003189;text-align:center;line-height:1.25;\">Verificación registrada<\u002Fdiv>\n                    <div style=\"font-size:12px;color:#3D5A82;text-align:center;line-height:1.6;\">Su respuesta constituye la constancia de entrega y comprensión de la Carta, conforme al artículo 5 de la Resolución.<\u002Fdiv>\n                    <div style=\"width:100%;background:#fff;border:1.5px solid #003189;border-radius:14px;padding:14px;\">\n                      <div style=\"font-size:11px;font-weight:800;color:#003189;margin-bottom:9px;\">Resumen<\u002Fdiv>\n                      <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                        <div style=\"display:flex;justify-content:space-between;gap:10px;\"><div style=\"font-size:11.5px;color:#3D5A82;\">Preguntas respondidas<\u002Fdiv><div style=\"font-size:11.5px;font-weight:900;color:#003189;font-family:Verdana,monospace;\">{{ verRespondidas }} / {{ verTotal }}<\u002Fdiv><\u002Fdiv>\n                        <div style=\"display:flex;justify-content:space-between;gap:10px;\"><div style=\"font-size:11.5px;color:#3D5A82;\">Fecha de constancia<\u002Fdiv><div style=\"font-size:11.5px;font-weight:900;color:#003189;\">{{ fecha }}<\u002Fdiv><\u002Fdiv>\n                        <div style=\"display:flex;justify-content:space-between;gap:10px;\"><div style=\"font-size:11.5px;color:#3D5A82;\">Radicado (simulado)<\u002Fdiv><div style=\"font-size:11.5px;font-weight:900;color:#003189;font-family:Verdana,monospace;\">{{ verRad }}<\u002Fdiv><\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ closeVer }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:14px;padding:16px;background:#fff;font-family:'Nunito Sans',sans-serif;font-size:15px;font-weight:900;color:#003189;cursor:pointer;\" style-hover=\"background:#EAF0FA;\">Volver al módulo<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n                <sc-if value=\"{{ verActiva }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"flex:1;min-height:0;overflow-y:auto;padding:14px 15px;\">\n                    <div style=\"background:#fff;border:1.5px solid #003189;border-radius:14px;padding:15px;animation:fadeUp .25s ease;\">\n                      <div style=\"display:flex;align-items:center;gap:7px;margin-bottom:7px;\">\n                        <span style=\"font-size:9.5px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.08em;\">Pregunta {{ verNum }} de {{ verTotal }}<\u002Fspan>\n                        <span style=\"border:1.5px solid #003189;border-radius:16px;padding:3px 9px;font-size:9px;color:#003189;font-weight:800;\">{{ verArt }}<\u002Fspan>\n                      <\u002Fdiv>\n                      <div style=\"font-size:15px;font-weight:800;color:#003189;line-height:1.45;margin-bottom:13px;\">{{ verText }}<\u002Fdiv>\n                      <sc-if value=\"{{ verIsOpts }}\" hint-placeholder-val=\"{{ true }}\">\n                        <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                          <sc-for list=\"{{ verOptsV }}\" as=\"vo\" hint-placeholder-count=\"4\">\n                            <div sc-camel-on-click=\"{{ vo.pick }}\" style=\"display:flex;align-items:center;gap:10px;padding:13px 12px;border:1.5px solid #003189;border-radius:10px;cursor:pointer;font-size:13.5px;color:#003189;background:{{ vo.bg }};font-weight:{{ vo.fw }};min-height:50px;\">\n                              <div style=\"width:17px;height:17px;border-radius:50%;border:1.5px solid #003189;background:{{ vo.rBg }};flex-shrink:0;display:flex;align-items:center;justify-content:center;\">\n                                <sc-if value=\"{{ vo.sel }}\" hint-placeholder-val=\"{{ false }}\">\n                                  <div style=\"width:6px;height:6px;border-radius:50%;background:#fff;\"><\u002Fdiv>\n                                <\u002Fsc-if>\n                              <\u002Fdiv>\n                              <span>{{ vo.label }}<\u002Fspan>\n                            <\u002Fdiv>\n                          <\u002Fsc-for>\n                        <\u002Fdiv>\n                      <\u002Fsc-if>\n                      <sc-if value=\"{{ verIsEscala }}\" hint-placeholder-val=\"{{ false }}\">\n                        <div style=\"display:grid;grid-template-columns:repeat(5,1fr);gap:6px;\">\n                          <sc-for list=\"{{ verEscalaV }}\" as=\"ve\" hint-placeholder-count=\"10\">\n                            <div sc-camel-on-click=\"{{ ve.pick }}\" style=\"border:1.5px solid #003189;border-radius:9px;padding:12px 3px;font-family:Verdana,monospace;font-size:15px;font-weight:700;color:{{ ve.fc }};background:{{ ve.bg }};cursor:pointer;text-align:center;min-height:46px;\">{{ ve.n }}<\u002Fdiv>\n                          <\u002Fsc-for>\n                        <\u002Fdiv>\n                        <div style=\"display:flex;justify-content:space-between;margin-top:5px;\">\n                          <span style=\"font-size:10px;color:#3D5A82;font-weight:700;\">Nada<\u002Fspan>\n                          <span style=\"font-size:10px;color:#3D5A82;font-weight:700;\">Totalmente<\u002Fspan>\n                        <\u002Fdiv>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"flex-shrink:0;background:#fff;border-top:1.5px solid #003189;padding:10px 15px 11px;display:flex;align-items:center;gap:10px;\">\n                    <div style=\"flex:1;min-width:0;\">\n                      <div style=\"font-size:9.5px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;\">Avance {{ verNum }} de {{ verTotal }}<\u002Fdiv>\n                      <div style=\"height:6px;border:1.5px solid #003189;border-radius:8px;overflow:hidden;\">\n                        <div style=\"height:100%;background:#003189;transition:width .4s;width:{{ verProgW }};\"><\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ verNext }}\" style=\"flex-shrink:0;border:1.5px solid #003189;background:#fff;color:#003189;padding:13px 18px;border-radius:11px;font-family:'Nunito Sans',sans-serif;font-size:13px;font-weight:900;cursor:pointer;white-space:nowrap;min-height:46px;\" style-hover=\"background:#EAF0FA;\">{{ verNextLbl }}<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <!-- ── VISOR DE FLASHCARDS ── -->\n            <sc-if value=\"{{ deckOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div data-screen-label=\"Flashcards\" style=\"position:absolute;inset:0;z-index:50;display:flex;flex-direction:column;background:#003189;\">\n                <div style=\"flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:14px 16px 6px;\">\n                  <div>\n                    <div style=\"font-size:16px;font-weight:900;color:#fff;\">{{ dkTitulo }}<\u002Fdiv>\n                    <div style=\"font-size:10.5px;color:rgba(255,255,255,.85);font-weight:700;\">{{ dkSub }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ closeDeck }}\" style=\"width:40px;height:40px;border-radius:50%;border:none;background:rgba(255,255,255,.22);color:#fff;font-size:16px;cursor:pointer;font-weight:800;\">✕<\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"flex-shrink:0;padding:4px 16px 10px;\">\n                  <div style=\"height:5px;background:rgba(255,255,255,.25);border-radius:4px;overflow:hidden;\">\n                    <div style=\"height:100%;background:#fff;border-radius:4px;transition:width .3s;width:{{ dkProg }};\"><\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:8px 22px;\">\n                  <div style=\"background:#fff;border:1.5px solid #003189;border-radius:20px;padding:26px 22px;width:100%;min-height:300px;display:flex;flex-direction:column;gap:13px;justify-content:center;animation:fadeUp .25s ease;\">\n                    <div style=\"font-size:10.5px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.1em;\">Tarjeta {{ dkNum }} de {{ dkTotal }}<\u002Fdiv>\n                    <div style=\"font-size:21px;font-weight:900;color:#003189;line-height:1.2;\">{{ cardT }}<\u002Fdiv>\n                    <div style=\"width:44px;height:3px;border-radius:3px;background:#003189;\"><\u002Fdiv>\n                    <div style=\"font-size:14.5px;color:#1B3A6B;line-height:1.65;\">{{ cardD }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:14px;padding:12px 16px 24px;\">\n                  <button sc-camel-on-click=\"{{ prevCard }}\" style=\"width:50px;height:50px;border-radius:50%;border:none;background:rgba(255,255,255,.22);color:#fff;font-size:19px;cursor:pointer;\">‹<\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ nextCard }}\" style=\"height:50px;border-radius:25px;border:1.5px solid #fff;background:#fff;color:#003189;font-family:'Nunito Sans',sans-serif;font-size:14px;font-weight:900;padding:0 28px;cursor:pointer;\">{{ dkNextLbl }}<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <!-- ── DESEMPEÑO ── -->\n            <sc-if value=\"{{ tabDes }}\" hint-placeholder-val=\"{{ false }}\">\n              <div data-screen-label=\"Módulo Carta de Desempeño\" style=\"position:absolute;inset:0;overflow-y:auto;background:#F2F6F5;\">\n                <div style=\"background:linear-gradient(135deg,#0B5E56,#1F8A80);padding:14px 16px 18px;\">\n                  <div style=\"display:flex;align-items:center;gap:11px;\">\n                    <div style=\"width:48px;height:48px;border-radius:13px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                      <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:26px;height:26px;\" fill=\"#fff\"><path d=\"M5 9h3v11H5zM10.5 4h3v16h-3zM16 13h3v7h-3z\"><\u002Fpath><\u002Fsvg>\n                    <\u002Fdiv>\n                    <div>\n                      <div style=\"font-size:17px;font-weight:900;color:#fff;\">Carta de Desempeño<\u002Fdiv>\n                      <div style=\"font-size:11px;color:rgba(255,255,255,.75);\">Indicadores de calidad · ENUS + ONCAS<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"padding:13px 13px 20px;display:flex;flex-direction:column;gap:12px;\">\n                  <sc-if value=\"{{ isGuest }}\" hint-placeholder-val=\"{{ false }}\">\n                    <div style=\"background:linear-gradient(135deg,#FFF6E8,#FFF9F0);border:1.5px solid #F2D9A6;border-radius:12px;padding:12px 14px;\">\n                      <div style=\"font-size:12.5px;font-weight:900;color:#8A5A00;margin-bottom:3px;\">Modo consulta — sin afiliación<\u002Fdiv>\n                      <div style=\"font-size:11px;color:#7A5A20;line-height:1.55;\">Compare aquí el desempeño de las EPS para <strong>elegir su mejor opción<\u002Fstrong> al momento de afiliarse. La afiliación es gratuita y es su derecho.<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fsc-if>\n                  <sc-if value=\"{{ hasSes }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"background:#fff;border-radius:14px;padding:15px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:10px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.09em;margin-bottom:2px;\">Su EPS<\u002Fdiv>\n                    <div style=\"font-size:16px;font-weight:900;color:#003189;margin-bottom:11px;\">{{ sesEps }}<\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;gap:15px;\">\n                      <div style=\"font-size:48px;font-weight:900;line-height:1;font-family:Verdana,monospace;color:{{ scoreColor }};\">{{ myScore }}<\u002Fdiv>\n                      <div style=\"flex:1;min-width:0;\">\n                        <div style=\"font-size:10.5px;font-weight:700;color:#3D5A82;margin-bottom:4px;\">Calificación de experiencia (0–100)<\u002Fdiv>\n                        <div style=\"height:7px;background:#EAF0EE;border-radius:6px;overflow:hidden;margin-bottom:4px;\">\n                          <div style=\"height:100%;border-radius:6px;background:linear-gradient(90deg,#32B1A5,#57C231);width:{{ myScoreW }};transition:width 1s;\"><\u002Fdiv>\n                        <\u002Fdiv>\n                        <div style=\"font-size:10.5px;color:#3D5A82;font-weight:600;\">Promedio nacional: <strong style=\"color:#003189;\">{{ natScore }}<\u002Fstrong><\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"background:#fff;border-radius:14px;padding:15px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:13.5px;font-weight:900;color:#003189;margin-bottom:11px;\">Indicadores por atributo de calidad<\u002Fdiv>\n                    <div style=\"display:flex;flex-direction:column;gap:10px;\">\n                      <sc-for list=\"{{ attrsV }}\" as=\"at\" hint-placeholder-count=\"5\">\n                        <div>\n                          <div style=\"display:flex;justify-content:space-between;margin-bottom:3px;\">\n                            <div style=\"font-size:11.5px;font-weight:700;color:#1B3A6B;\">{{ at.a }}<\u002Fdiv>\n                            <div style=\"font-size:11.5px;font-weight:900;color:#003189;font-family:Verdana,monospace;\">{{ at.v }}<\u002Fdiv>\n                          <\u002Fdiv>\n                          <div style=\"height:6px;background:#EAF0EE;border-radius:5px;position:relative;\">\n                            <div style=\"height:100%;border-radius:5px;background:linear-gradient(90deg,#32B1A5,#57C231);width:{{ at.w }};\"><\u002Fdiv>\n                            <div style=\"position:absolute;top:-2px;bottom:-2px;width:2px;background:#003189;border-radius:2px;left:{{ at.nw }};\" title=\"Promedio nacional\"><\u002Fdiv>\n                          <\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;gap:5px;margin-top:10px;\">\n                      <div style=\"width:12px;height:2px;background:#003189;\"><\u002Fdiv>\n                      <div style=\"font-size:9.5px;color:#3D5A82;font-weight:700;\">Promedio nacional por atributo<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <\u002Fsc-if>\n                  <div style=\"background:#fff;border-radius:14px;padding:15px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:13.5px;font-weight:900;color:#003189;margin-bottom:11px;\">{{ rankTitle }}<\u002Fdiv>\n                    <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                      <sc-for list=\"{{ rankingV }}\" as=\"r\" hint-placeholder-count=\"7\">\n                        <div style=\"display:flex;align-items:center;gap:8px;\">\n                          <div style=\"width:15px;font-size:10px;font-weight:800;color:#7B93B5;font-family:Verdana,monospace;\">{{ r.pos }}<\u002Fdiv>\n                          <div style=\"width:96px;font-size:10.5px;font-weight:{{ r.fw }};color:{{ r.fc }};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ r.n }}<\u002Fdiv>\n                          <div style=\"flex:1;height:13px;background:#EAF0EE;border-radius:7px;overflow:hidden;\">\n                            <div style=\"height:100%;border-radius:7px;background:{{ r.bg }};width:{{ r.w }};\"><\u002Fdiv>\n                          <\u002Fdiv>\n                          <div style=\"width:22px;font-size:11px;font-weight:900;color:#003189;font-family:Verdana,monospace;text-align:right;\">{{ r.v }}<\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <sc-if value=\"{{ hasSes }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"background:#fff;border-radius:14px;padding:15px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:13.5px;font-weight:900;color:#003189;margin-bottom:8px;\">Tendencia 2022–2026<\u002Fdiv>\n                    <svg sc-camel-view-box=\"0 0 300 110\" style=\"width:100%;display:block;\">\n                      <line x1=\"0\" y1=\"100\" x2=\"300\" y2=\"100\" stroke=\"#EAF0EE\" stroke-width=\"1\"><\u002Fline>\n                      <line x1=\"0\" y1=\"60\" x2=\"300\" y2=\"60\" stroke=\"#EAF0EE\" stroke-width=\"1\"><\u002Fline>\n                      <line x1=\"0\" y1=\"20\" x2=\"300\" y2=\"20\" stroke=\"#EAF0EE\" stroke-width=\"1\"><\u002Fline>\n                      <polyline points=\"{{ trendNat }}\" fill=\"none\" stroke=\"#003189\" stroke-width=\"2\" stroke-dasharray=\"4,3\"><\u002Fpolyline>\n                      <polyline points=\"{{ trendEps }}\" fill=\"none\" stroke=\"#32B1A5\" stroke-width=\"2.5\"><\u002Fpolyline>\n                    <\u002Fsvg>\n                    <div style=\"display:flex;justify-content:space-between;margin-top:2px;\">\n                      <sc-for list=\"{{ trendLabels }}\" as=\"tl\" hint-placeholder-count=\"5\">\n                        <div style=\"font-size:9.5px;color:#7B93B5;font-weight:700;font-family:Verdana,monospace;\">{{ tl.y }}<\u002Fdiv>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;gap:14px;margin-top:8px;\">\n                      <div style=\"display:flex;align-items:center;gap:5px;\"><div style=\"width:14px;height:3px;background:#32B1A5;border-radius:2px;\"><\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;font-weight:700;\">Su EPS<\u002Fdiv><\u002Fdiv>\n                      <div style=\"display:flex;align-items:center;gap:5px;\"><div style=\"width:14px;height:3px;background:#003189;border-radius:2px;\"><\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;font-weight:700;\">Nacional<\u002Fdiv><\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <\u002Fsc-if>\n                  <div style=\"background:#fff;border-radius:14px;padding:15px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:13.5px;font-weight:900;color:#003189;margin-bottom:11px;\">Experiencia por región<\u002Fdiv>\n                    <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                      <sc-for list=\"{{ regionesV }}\" as=\"rg\" hint-placeholder-count=\"6\">\n                        <div style=\"display:flex;align-items:center;gap:8px;\">\n                          <div style=\"width:66px;font-size:11px;font-weight:700;color:#1B3A6B;\">{{ rg.n }}<\u002Fdiv>\n                          <div style=\"flex:1;height:11px;background:#EAF0EE;border-radius:6px;overflow:hidden;\">\n                            <div style=\"height:100%;border-radius:6px;background:linear-gradient(90deg,#7FCEC5,#1F8A80);width:{{ rg.w }};\"><\u002Fdiv>\n                          <\u002Fdiv>\n                          <div style=\"width:56px;font-size:9.5px;color:#7B93B5;text-align:right;font-weight:700;\">{{ rg.part }} resp.<\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"background:linear-gradient(135deg,#EAF3FF,#EEF6FF);border-radius:12px;padding:13px 14px;border:1.5px solid #C4D8F2;\">\n                    <div style=\"font-size:12.5px;font-weight:900;color:#003189;margin-bottom:3px;\">Observatorio Nacional de Calidad — ONCAS<\u002Fdiv>\n                    <div style=\"font-size:10.5px;color:#3D5A82;line-height:1.55;margin-bottom:8px;\">Los indicadores completos y los datos abiertos de la Carta de Desempeño se publican en el portal del Ministerio.<\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ irOncas }}\" style=\"border:none;background:#003189;color:#fff;border-radius:9px;padding:10px 15px;font-family:'Nunito Sans',sans-serif;font-size:11.5px;font-weight:800;cursor:pointer;min-height:40px;\">Abrir tablero ciudadano ↗<\u002Fbutton>\n                  <\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ openVerDes }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:13px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:11px;text-align:left;min-height:60px;\" style-hover=\"background:#EAF0FA;\">\n                    <div style=\"width:34px;height:30px;background:#EAF0FA;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg sc-camel-view-box=\"0 0 24 24\" style=\"width:17px;height:17px;\" fill=\"none\" stroke=\"#003189\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 11l3 3 6-6\"><\u002Fpath><path d=\"M21 12a9 9 0 1 1-4.2-7.6\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n                    <div style=\"flex:1;\"><div style=\"font-size:13px;font-weight:900;\">Encuesta de verificación<\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;\">¿Le sirvió esta información? · 10 preguntas<\u002Fdiv><\u002Fdiv>\n                    <span style=\"color:#003189;\">›<\u002Fspan>\n                  <\u002Fbutton>\n                  <div style=\"font-size:9.5px;color:#7B93B5;text-align:center;line-height:1.6;\">Actualización periódica · Datos abiertos (Ley 1712/2014)<br>Fuente: ENUS 2026 + ONCAS · Ministerio de Salud y Protección Social<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <!-- ── ENCUESTA ── -->\n            <sc-if value=\"{{ tabEnc }}\" hint-placeholder-val=\"{{ false }}\">\n              <div data-screen-label=\"Módulo Encuesta ENUS\" style=\"position:absolute;inset:0;display:flex;flex-direction:column;background:#F2F6F5;\">\n\n                <sc-if value=\"{{ encLocked }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"position:absolute;inset:0;overflow-y:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:26px;\">\n                    <div style=\"width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,#E4F5F2,#D2EFEA);display:flex;align-items:center;justify-content:center;\">\n                      <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:30px;height:30px;\" fill=\"none\" stroke=\"#1F8A80\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"><\u002Frect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"><\u002Fpath><\u002Fsvg>\n                    <\u002Fdiv>\n                    <div style=\"font-size:17px;font-weight:900;color:#003189;text-align:center;line-height:1.3;\">La encuesta es solo para<br>personas afiliadas<\u002Fdiv>\n                    <div style=\"font-size:12px;color:#3D5A82;text-align:center;line-height:1.6;\">La ENUS mide la experiencia real de los usuarios del sistema. Para responderla necesita una afiliación <strong>ACTIVA<\u002Fstrong> en BDUA.<\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ logout }}\" style=\"width:100%;border:none;border-radius:14px;padding:16px;background:linear-gradient(135deg,#32B1A5,#57C231);font-family:'Nunito Sans',sans-serif;font-size:15px;font-weight:900;color:#fff;cursor:pointer;box-shadow:0 4px 14px rgba(50,177,165,.32);\">Identificarme con mi documento<\u002Fbutton>\n                    <div style=\"font-size:11px;color:#3D5A82;text-align:center;line-height:1.6;background:#fff;border-radius:12px;padding:10px 14px;border:1.5px solid #003189;\">¿Aún no está afiliado? Acérquese a la EPS de su preferencia o afíliese en <strong style=\"color:#003189;\">www.miseguridadsocial.gov.co<\u002Fstrong><\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n\n                <sc-if value=\"{{ encInicio }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"position:absolute;inset:0;overflow-y:auto;\">\n                    <div style=\"background:linear-gradient(135deg,#32B1A5,#57C231);padding:14px 16px 18px;\">\n                      <div style=\"display:flex;align-items:center;gap:11px;\">\n                        <div style=\"width:48px;height:48px;border-radius:13px;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                          <img src=\"1dcbc51e-6762-4e2d-b2bf-497dc267d691\" alt=\"\" style=\"width:40px;height:36px;object-fit:contain;\">\n                        <\u002Fdiv>\n                        <div>\n                          <div style=\"font-size:17px;font-weight:900;color:#fff;\">Clic<span style=\"color:#EAFBE4;\">Salud<\u002Fspan><\u002Fdiv>\n                          <div style=\"font-size:11px;color:rgba(255,255,255,.85);\">Encuesta Nacional de Experiencia · ENUS 2026<\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"padding:13px 13px 20px;display:flex;flex-direction:column;gap:11px;\">\n                      <div style=\"background:#fff;border-radius:12px;padding:11px 13px;display:flex;align-items:center;gap:10px;border:1.5px solid #003189;\">\n                        <div style=\"width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#E4F5F2,#D2EFEA);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                          <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:19px;height:19px;\" fill=\"#32B1A5\"><path d=\"M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z\"><\u002Fpath><\u002Fsvg>\n                        <\u002Fdiv>\n                        <div style=\"flex:1;min-width:0;\">\n                          <div style=\"font-size:9px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.07em;\">Sesión activa · BDUA verificado<\u002Fdiv>\n                          <div style=\"font-size:13px;font-weight:800;color:#003189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ sesNombre }}<\u002Fdiv>\n                          <div style=\"font-size:10px;color:#3D5A82;\">{{ sesEps }} · {{ sesTipo }}<\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fdiv>\n                      <sc-if value=\"{{ esContributivo }}\" hint-placeholder-val=\"{{ true }}\">\n                        <div style=\"background:#fff;border-radius:14px;padding:14px;border:1.5px solid #003189;\">\n                          <div style=\"font-size:11px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px;\">Atenciones detectadas — FEVRIPS · últimos 6 meses<\u002Fdiv>\n                          <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                            <sc-for list=\"{{ serviciosV }}\" as=\"s\" hint-placeholder-count=\"3\">\n                              <div style=\"display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid #003189;border-radius:10px;padding:10px 12px;\">\n                                <div style=\"width:9px;height:9px;border-radius:50%;background:linear-gradient(135deg,{{ s.c1 }},{{ s.c2 }});flex-shrink:0;\"><\u002Fdiv>\n                                <div style=\"flex:1;min-width:0;\">\n                                  <div style=\"font-size:12.5px;font-weight:800;color:#003189;\">{{ s.tip }}<\u002Fdiv>\n                                  <div style=\"font-size:10px;color:#3D5A82;\">{{ s.detalle }}<\u002Fdiv>\n                                <\u002Fdiv>\n                              <\u002Fdiv>\n                            <\u002Fsc-for>\n                          <\u002Fdiv>\n                          <sc-if value=\"{{ sinServicios }}\" hint-placeholder-val=\"{{ false }}\">\n                            <div style=\"background:#FFF8E1;border:1.5px solid #FFE082;border-radius:9px;padding:10px 12px;font-size:11px;color:#7A4F00;line-height:1.5;\">Sin atenciones registradas en los últimos 6 meses. Responderá solo las preguntas generales.<\u002Fdiv>\n                          <\u002Fsc-if>\n                        <\u002Fdiv>\n                      <\u002Fsc-if>\n                      <sc-if value=\"{{ esSubsidiado }}\" hint-placeholder-val=\"{{ false }}\">\n                        <div style=\"background:#fff;border-radius:14px;padding:14px;border:1.5px solid #003189;\">\n                          <div style=\"font-size:11px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px;\">¿Qué servicios usó en los últimos 6 meses?<\u002Fdiv>\n                          <div style=\"font-size:10px;color:#7B93B5;margin-bottom:10px;\">Puede marcar varios<\u002Fdiv>\n                          <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                            <sc-for list=\"{{ srvChecksV }}\" as=\"sc\" hint-placeholder-count=\"6\">\n                              <div sc-camel-on-click=\"{{ sc.toggle }}\" style=\"display:flex;align-items:center;gap:10px;background:{{ sc.bg }};border:1.5px solid {{ sc.bc }};border-radius:11px;padding:11px 12px;cursor:pointer;min-height:52px;\">\n                                <div style=\"width:20px;height:20px;border-radius:6px;border:1.5px solid {{ sc.boxBc }};background:{{ sc.boxBg }};display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                                  <sc-if value=\"{{ sc.on }}\" hint-placeholder-val=\"{{ false }}\">\n                                    <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:13px;height:13px;\" fill=\"#fff\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"><\u002Fpath><\u002Fsvg>\n                                  <\u002Fsc-if>\n                                <\u002Fdiv>\n                                <div style=\"flex:1;min-width:0;\">\n                                  <div style=\"font-size:12.5px;font-weight:800;color:#003189;\">{{ sc.nombre }}<\u002Fdiv>\n                                  <div style=\"font-size:10px;color:#3D5A82;\">{{ sc.desc }}<\u002Fdiv>\n                                <\u002Fdiv>\n                              <\u002Fdiv>\n                            <\u002Fsc-for>\n                          <\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fsc-if>\n                      <button sc-camel-on-click=\"{{ startEnc }}\" style=\"width:100%;border:none;border-radius:14px;padding:17px;font-family:'Nunito Sans',sans-serif;font-size:16px;font-weight:900;cursor:pointer;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;box-shadow:0 4px 14px rgba(50,177,165,.32);\">Iniciar encuesta →<\u002Fbutton>\n                      <div style=\"background:#fff;border-radius:10px;padding:10px 13px;border:1.5px solid #003189;\">\n                        <div style=\"font-size:10.5px;color:#3D5A82;line-height:1.6;\">~5 minutos · Preguntas adaptadas a sus servicios · Forma A o B asignada según su documento · Resultados <strong style=\"color:#003189;\">anónimos y agregados<\u002Fstrong>.<\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n\n                <sc-if value=\"{{ encPregunta }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"position:absolute;inset:0;display:flex;flex-direction:column;\">\n                    <div style=\"flex-shrink:0;background:linear-gradient(135deg,{{ qC1 }},{{ qC2 }});padding:12px 14px 13px;\">\n                      <div style=\"display:flex;align-items:center;justify-content:space-between;\">\n                        <div>\n                          <div style=\"font-size:14.5px;font-weight:900;color:#fff;\">{{ qHdr }}<\u002Fdiv>\n                          <div style=\"font-size:10px;color:rgba(255,255,255,.85);font-weight:700;\">{{ qSubHdr }}<\u002Fdiv>\n                        <\u002Fdiv>\n                        <sc-if value=\"{{ qFormaOn }}\" hint-placeholder-val=\"{{ false }}\">\n                          <div style=\"background:rgba(255,255,255,.2);border-radius:7px;padding:4px 10px;font-size:10.5px;font-weight:900;color:#fff;letter-spacing:.05em;\">Forma {{ qForma }}<\u002Fdiv>\n                        <\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"flex:1;min-height:0;overflow-y:auto;padding:13px;\">\n                      <div style=\"background:#fff;border-radius:14px;padding:14px;border:1.5px solid #003189;animation:fadeUp .25s ease;\">\n                        <div style=\"font-size:9.5px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;display:flex;align-items:center;gap:6px;\">\n                          <span>Pregunta {{ qNum }}<\u002Fspan>\n                          <span style=\"background:#F2F6F5;border-radius:16px;padding:3px 9px;font-size:9px;color:#3D5A82;text-transform:none;letter-spacing:0;\">{{ qDim }}<\u002Fspan>\n                        <\u002Fdiv>\n                        <div style=\"font-size:15px;font-weight:800;color:#003189;line-height:1.45;margin-bottom:13px;\">{{ qText }}<\u002Fdiv>\n                        <sc-if value=\"{{ qIsOpts }}\" hint-placeholder-val=\"{{ true }}\">\n                          <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                            <sc-for list=\"{{ qOptsV }}\" as=\"op\" hint-placeholder-count=\"4\">\n                              <div sc-camel-on-click=\"{{ op.pick }}\" style=\"display:flex;align-items:center;gap:10px;padding:13px 12px;border:1.5px solid {{ op.bc }};border-radius:10px;cursor:pointer;font-size:13.5px;color:{{ op.fc }};background:{{ op.bg }};font-weight:{{ op.fw }};min-height:50px;\">\n                                <div style=\"width:17px;height:17px;border-radius:50%;border:1.5px solid {{ op.rBc }};background:{{ op.rBg }};flex-shrink:0;display:flex;align-items:center;justify-content:center;\">\n                                  <sc-if value=\"{{ op.sel }}\" hint-placeholder-val=\"{{ false }}\">\n                                    <div style=\"width:6px;height:6px;border-radius:50%;background:#fff;\"><\u002Fdiv>\n                                  <\u002Fsc-if>\n                                <\u002Fdiv>\n                                <span>{{ op.label }}<\u002Fspan>\n                              <\u002Fdiv>\n                            <\u002Fsc-for>\n                          <\u002Fdiv>\n                        <\u002Fsc-if>\n                        <sc-if value=\"{{ qIsEscala }}\" hint-placeholder-val=\"{{ false }}\">\n                          <div style=\"display:grid;grid-template-columns:repeat(5,1fr);gap:6px;\">\n                            <sc-for list=\"{{ escalaV }}\" as=\"es\" hint-placeholder-count=\"10\">\n                              <div sc-camel-on-click=\"{{ es.pick }}\" style=\"border:1.5px solid {{ es.bc }};border-radius:9px;padding:12px 3px;font-family:Verdana,monospace;font-size:15px;font-weight:700;color:{{ es.fc }};background:{{ es.bg }};cursor:pointer;text-align:center;min-height:46px;\">{{ es.n }}<\u002Fdiv>\n                            <\u002Fsc-for>\n                          <\u002Fdiv>\n                          <div style=\"display:flex;justify-content:space-between;margin-top:5px;\">\n                            <span style=\"font-size:10px;color:#7B93B5;font-weight:700;\">Muy malo<\u002Fspan>\n                            <span style=\"font-size:10px;color:#7B93B5;font-weight:700;\">Excelente<\u002Fspan>\n                          <\u002Fdiv>\n                        <\u002Fsc-if>\n                        <sc-if value=\"{{ qIsNum }}\" hint-placeholder-val=\"{{ false }}\">\n                          <input type=\"tel\" value=\"{{ numVal }}\" sc-camel-on-change=\"{{ onNum }}\" placeholder=\"0\" style=\"width:100%;background:#EEF6F5;border:2px solid #003189;border-radius:10px;padding:13px;font-family:Verdana,monospace;font-size:19px;font-weight:500;color:#003189;outline:none;text-align:center;min-height:52px;\">\n                        <\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"flex-shrink:0;background:#fff;border-top:1px solid #DDE7E5;padding:9px 13px 10px;display:flex;align-items:center;gap:10px;\">\n                      <div style=\"flex:1;min-width:0;\">\n                        <div style=\"font-size:9.5px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;\">{{ progLbl }}<\u002Fdiv>\n                        <div style=\"height:6px;background:#EAF0EE;border-radius:8px;overflow:hidden;\">\n                          <div style=\"height:100%;background:linear-gradient(90deg,#32B1A5,#57C231);border-radius:8px;transition:width .4s;width:{{ progW }};\"><\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fdiv>\n                      <button sc-camel-on-click=\"{{ nextQ }}\" style=\"flex-shrink:0;background:linear-gradient(135deg,#32B1A5,#57C231);color:#fff;border:none;padding:13px 18px;border-radius:11px;font-family:'Nunito Sans',sans-serif;font-size:13px;font-weight:900;cursor:pointer;white-space:nowrap;box-shadow:0 3px 9px rgba(50,177,165,.3);min-height:46px;\">{{ nextLbl }}<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n\n                <sc-if value=\"{{ encFin }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"position:absolute;inset:0;overflow-y:auto;background:#fff;\">\n                    <div style=\"padding:22px 16px 24px;display:flex;flex-direction:column;align-items:center;gap:13px;\">\n                      <div style=\"width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#32B1A5,#57C231);display:flex;align-items:center;justify-content:center;box-shadow:0 7px 20px rgba(50,177,165,.3);animation:popIn .5s cubic-bezier(.34,1.56,.64,1);\">\n                        <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:29px;height:29px;\" fill=\"#fff\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"><\u002Fpath><\u002Fsvg>\n                      <\u002Fdiv>\n                      <div style=\"font-size:21px;font-weight:900;color:#003189;text-align:center;line-height:1.2;\">Gracias por<br><span style=\"color:#1F8A80;\">participar<\u002Fspan><\u002Fdiv>\n                      <div style=\"font-size:12px;color:#3D5A82;text-align:center;line-height:1.6;\">Su respuesta fue registrada y contribuye a mejorar<br>el sistema de salud colombiano.<\u002Fdiv>\n                      <div style=\"width:100%;background:#fff;border:1.5px solid #003189;border-radius:14px;padding:14px;display:flex;align-items:center;gap:13px;\">\n                        <div style=\"font-size:44px;font-weight:900;line-height:1;font-family:Verdana,monospace;color:{{ scoreColor }};\">{{ myScore }}<\u002Fdiv>\n                        <div style=\"flex:1;min-width:0;\">\n                          <div style=\"font-size:10.5px;font-weight:700;color:#3D5A82;margin-bottom:3px;\">{{ sesEps }} · calificación de experiencia<\u002Fdiv>\n                          <div style=\"height:6px;background:#E0E9E6;border-radius:8px;overflow:hidden;margin-bottom:3px;\">\n                            <div style=\"height:100%;background:linear-gradient(90deg,#32B1A5,#57C231);border-radius:8px;width:{{ myScoreW }};\"><\u002Fdiv>\n                          <\u002Fdiv>\n                          <div style=\"font-size:10.5px;color:#3D5A82;font-weight:600;\">Nacional: <strong style=\"color:#003189;\">{{ natScore }}<\u002Fstrong><\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fdiv>\n                      <div style=\"width:100%;display:flex;flex-direction:column;gap:8px;\">\n                        <div style=\"font-size:10px;font-weight:800;color:#3D5A82;text-transform:uppercase;letter-spacing:.1em;text-align:center;margin-top:2px;\">Siga explorando<\u002Fdiv>\n                        <button sc-camel-on-click=\"{{ finGoDer }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:13px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:11px;text-align:left;min-height:60px;\">\n                          <img src=\"b5af4583-3fe7-4e5f-92e2-32887fef8efb\" alt=\"\" style=\"width:34px;height:30px;object-fit:contain;background:#fff;border-radius:9px;padding:3px;flex-shrink:0;\">\n                          <div style=\"flex:1;\"><div style=\"font-size:13px;font-weight:900;\">Conozca sus derechos<\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;\">Carta de Derechos y Deberes por EPS<\u002Fdiv><\u002Fdiv>\n                          <span style=\"color:#003189;\">›<\u002Fspan>\n                        <\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ finGoDes }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:13px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:11px;text-align:left;min-height:60px;\">\n                          <div style=\"width:34px;height:30px;background:#EAF0FA;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg sc-camel-view-box=\"0 0 24 24\" style=\"width:17px;height:17px;\" fill=\"#003189\"><path d=\"M5 9h3v11H5zM10.5 4h3v16h-3zM16 13h3v7h-3z\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n                          <div style=\"flex:1;\"><div style=\"font-size:13px;font-weight:900;\">Compare su EPS<\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;\">Carta de Desempeño · indicadores de calidad<\u002Fdiv><\u002Fdiv>\n                          <span style=\"color:#003189;\">›<\u002Fspan>\n                        <\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ finGoNor }}\" style=\"width:100%;border:1.5px solid #003189;border-radius:13px;padding:13px 14px;font-family:'Nunito Sans',sans-serif;cursor:pointer;background:#fff;color:#003189;display:flex;align-items:center;gap:11px;text-align:left;min-height:60px;\" style-hover=\"border-color:#32B1A5;\">\n                          <div style=\"width:34px;height:30px;background:#EAF0FA;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg sc-camel-view-box=\"0 0 24 24\" style=\"width:17px;height:17px;\" fill=\"none\" stroke=\"#1F8A80\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\"><\u002Frect><path d=\"M8 7h8M8 11h8M8 15h5\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n                          <div style=\"flex:1;\"><div style=\"font-size:13px;font-weight:900;\">Normatividad<\u002Fdiv><div style=\"font-size:10px;color:#3D5A82;\">Las leyes que respaldan sus derechos<\u002Fdiv><\u002Fdiv>\n                          <span style=\"color:#003189;\">›<\u002Fspan>\n                        <\u002Fbutton>\n                      <\u002Fdiv>\n                      <button sc-camel-on-click=\"{{ resetEnc }}\" style=\"border:none;background:none;color:#7B93B5;font-family:'Nunito Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer;text-decoration:underline;\">Reiniciar encuesta (demo)<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <!-- ── NORMATIVIDAD ── -->\n            <sc-if value=\"{{ tabNor }}\" hint-placeholder-val=\"{{ false }}\">\n              <div data-screen-label=\"Normatividad\" style=\"position:absolute;inset:0;overflow-y:auto;background:#F2F6F5;\">\n                <div style=\"background:linear-gradient(135deg,#003189,#0A47B8);padding:14px 16px 18px;\">\n                  <div style=\"display:flex;align-items:center;gap:11px;\">\n                    <div style=\"width:48px;height:48px;border-radius:13px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                      <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:24px;height:24px;\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\"><\u002Frect><path d=\"M8 7h8M8 11h8M8 15h5\"><\u002Fpath><\u002Fsvg>\n                    <\u002Fdiv>\n                    <div>\n                      <div style=\"font-size:17px;font-weight:900;color:#fff;\">Normatividad<\u002Fdiv>\n                      <div style=\"font-size:11px;color:rgba(255,255,255,.75);\">Las leyes que respaldan sus derechos<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"padding:13px 13px 20px;display:flex;flex-direction:column;gap:9px;\">\n                  <sc-for list=\"{{ normasV }}\" as=\"nm\" hint-placeholder-count=\"5\">\n                    <div style=\"background:#fff;border-radius:12px;padding:12px 14px;border:1.5px solid #003189;display:flex;gap:11px;align-items:flex-start;\">\n                      <div style=\"width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#EAF0FA,#E4F5F2);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                        <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:16px;height:16px;\" fill=\"none\" stroke=\"#003189\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 3v18M5 7l7-4 7 4M4 21h16M7 7v10M17 7v10\"><\u002Fpath><\u002Fsvg>\n                      <\u002Fdiv>\n                      <div style=\"flex:1;\">\n                        <div style=\"font-size:13px;font-weight:900;color:#003189;line-height:1.3;\">{{ nm.n }}<\u002Fdiv>\n                        <div style=\"font-size:11px;color:#3D5A82;line-height:1.5;margin-top:2px;\">{{ nm.d }}<\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                  <div style=\"background:linear-gradient(135deg,#EAF3FF,#EEF6FF);border-radius:12px;padding:13px 14px;border:1.5px solid #C4D8F2;margin-top:4px;\">\n                    <div style=\"font-size:12.5px;font-weight:900;color:#003189;margin-bottom:3px;\">Observatorio Nacional de Calidad — ONCAS<\u002Fdiv>\n                    <div style=\"font-size:10.5px;color:#3D5A82;line-height:1.55;margin-bottom:8px;\">Consulte los resultados completos y los datos abiertos en el portal del Ministerio de Salud.<\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ irOncas }}\" style=\"border:none;background:#003189;color:#fff;border-radius:9px;padding:10px 15px;font-family:'Nunito Sans',sans-serif;font-size:11.5px;font-weight:800;cursor:pointer;min-height:40px;\">Abrir tablero ciudadano ↗<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"background:#fff;border-radius:11px;padding:11px 13px;border:1.5px solid #003189;\">\n                    <div style=\"font-size:10.5px;color:#3D5A82;line-height:1.6;\"><strong style=\"color:#003189;\">¿Necesita ayuda?<\u002Fstrong> Línea gratuita nacional <strong style=\"color:#003189;\">192<\u002Fstrong> · Superintendencia Nacional de Salud · Defensoría del Pueblo y personerías municipales.<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n\n          <!-- ── BARRA DE TABS ── -->\n          <div style=\"flex-shrink:0;background:#fff;border-top:1px solid #DDE7E5;display:flex;padding:6px 4px 4px;z-index:60;\">\n            <button sc-camel-on-click=\"{{ setTabIni }}\" style=\"flex:1;border:none;background:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 0;font-family:'Nunito Sans',sans-serif;min-height:52px;\">\n              <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:22px;height:22px;\" fill=\"none\" stroke=\"{{ tabIniC }}\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9.5L12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z\"><\u002Fpath><\u002Fsvg>\n              <span style=\"font-size:9px;font-weight:800;color:{{ tabIniC }};\">Inicio<\u002Fspan>\n            <\u002Fbutton>\n            <button sc-camel-on-click=\"{{ setTabDer }}\" style=\"flex:1;border:none;background:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 0;font-family:'Nunito Sans',sans-serif;min-height:52px;\">\n              <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:22px;height:22px;\" fill=\"none\" stroke=\"{{ tabDerC }}\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"><\u002Fpath><path d=\"M9 12l2 2 4-4\"><\u002Fpath><\u002Fsvg>\n              <span style=\"font-size:9px;font-weight:800;color:{{ tabDerC }};\">Derechos<\u002Fspan>\n            <\u002Fbutton>\n            <button sc-camel-on-click=\"{{ setTabDes }}\" style=\"flex:1;border:none;background:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 0;font-family:'Nunito Sans',sans-serif;min-height:52px;\">\n              <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:22px;height:22px;\" fill=\"none\" stroke=\"{{ tabDesC }}\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 20V10M12 20V4M19 20v-7\"><\u002Fpath><\u002Fsvg>\n              <span style=\"font-size:9px;font-weight:800;color:{{ tabDesC }};\">Desempeño<\u002Fspan>\n            <\u002Fbutton>\n            <button sc-camel-on-click=\"{{ setTabEnc }}\" style=\"flex:1;border:none;background:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 0;font-family:'Nunito Sans',sans-serif;min-height:52px;\">\n              <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:22px;height:22px;\" fill=\"none\" stroke=\"{{ tabEncC }}\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"><\u002Fpath><\u002Fsvg>\n              <span style=\"font-size:9px;font-weight:800;color:{{ tabEncC }};\">Encuesta<\u002Fspan>\n            <\u002Fbutton>\n            <button sc-camel-on-click=\"{{ setTabNor }}\" style=\"flex:1;border:none;background:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 0;font-family:'Nunito Sans',sans-serif;min-height:52px;\">\n              <svg sc-camel-view-box=\"0 0 24 24\" style=\"width:22px;height:22px;\" fill=\"none\" stroke=\"{{ tabNorC }}\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\"><\u002Frect><path d=\"M8 7h8M8 11h8M8 15h5\"><\u002Fpath><\u002Fsvg>\n              <span style=\"font-size:9px;font-weight:800;color:{{ tabNorC }};\">Normas<\u002Fspan>\n            <\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n    <\u002Fdiv>\n    <div style=\"flex-shrink:0;height:16px;display:flex;align-items:center;justify-content:center;background:#fff;\">\n      <div style=\"width:100px;height:4px;background:#080810;border-radius:3px;opacity:.13;\"><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;: {&quot;width&quot;: 430, &quot;height&quot;: 900}, &quot;mostrarPublicidad&quot;: {&quot;editor&quot;: &quot;boolean&quot;, &quot;default&quot;: true, &quot;tsType&quot;: &quot;boolean&quot;, &quot;section&quot;: &quot;Demo&quot;}, &quot;saltarLogin&quot;: {&quot;editor&quot;: &quot;boolean&quot;, &quot;default&quot;: false, &quot;tsType&quot;: &quot;boolean&quot;, &quot;section&quot;: &quot;Demo&quot;}, &quot;letraGrande&quot;: {&quot;editor&quot;: &quot;boolean&quot;, &quot;default&quot;: false, &quot;tsType&quot;: &quot;boolean&quot;, &quot;section&quot;: &quot;Accesibilidad&quot;}}\">\nclass Component extends DCLogic {\n  state = {\n    screen: \"ads\", adIdx: 0,\n    tipoDoc: \"CC\", cedula: \"\", ccErr: false,\n    otpVal: \"\", otpCode: \"\", otpErr: false,\n    ses: null, notFound: false, guest: false,\n    spinText: \"\", spinOn: false,\n    tab: \"inicio\", fzBig: false,\n    deck: null, cardIdx: 0,\n    epsSel: \"\",\n    verOn: false, verIdx: 0, verAns: {}, verDone: false,\n    selSrv: {},\n    encPhase: \"inicio\", trazIdx: 0, cola: [], blIdx: 0, qIdx: 0,\n    curAns: null, numVal: \"\",\n    toastMsg: \"\", hora: \"9:41\",\n    D: null\n  };\n\n  componentDidMount() {\n    this.otpRef = React.createRef();\n    const tick = () => {\n      const d = new Date();\n      this.setState({ hora: String(d.getHours()).padStart(2, \"0\") + \":\" + String(d.getMinutes()).padStart(2, \"0\") });\n    };\n    tick(); this._t = setInterval(tick, 30000);\n    Promise.resolve(window.__APPDATA).then(D => {\n      const patch = { D };\n      if (this.props.letraGrande ?? false) patch.fzBig = true;\n      if (this.props.saltarLogin ?? false) {\n        patch.screen = \"tabs\"; patch.ses = this._mkSes(\"1020304050\", D.BDUA[\"1020304050\"], D);\n      } else {\n        // sesión guardada en este teléfono\n        let saved = null;\n        try { saved = JSON.parse(localStorage.getItem(\"clicsalud_sesion_v1\")); } catch (e) {}\n        if (saved && saved.cc && D.BDUA[saved.cc] && !D.BDUA[saved.cc].estado) {\n          patch.screen = \"resume\"; patch.ses = this._mkSes(saved.cc, D.BDUA[saved.cc], D); patch.cedula = saved.cc;\n        } else if (!(this.props.mostrarPublicidad ?? true)) {\n          patch.screen = \"id\";\n        }\n      }\n      this.setState(patch);\n    });\n  }\n  componentWillUnmount() { clearInterval(this._t); }\n\n  _mkSes(cc, bd, D) {\n    return { cc, n: bd.n, eps: bd.eps, t: bd.t, m: bd.m, dpto: bd.dpto, reg: bd.reg, srvs: bd.reg === \"contributivo\" ? (D.FEVRIPS[cc] || []) : null };\n  }\n  spin(txt, ms, then) {\n    this.setState({ spinOn: true, spinText: txt });\n    setTimeout(() => { this.setState({ spinOn: false }); then(); }, ms);\n  }\n  toast(msg) {\n    this.setState({ toastMsg: msg });\n    clearTimeout(this._tt);\n    this._tt = setTimeout(() => this.setState({ toastMsg: \"\" }), 2200);\n  }\n\n  startEnc = () => {\n    const { D, ses } = this.state;\n    let srvs;\n    if (ses.reg === \"contributivo\") srvs = ses.srvs || [];\n    else {\n      const sel = Object.keys(this.state.selSrv).filter(k => this.state.selSrv[k]);\n      if (sel.length === 0) { this.toast(\"Seleccione al menos un servicio\"); return; }\n      srvs = sel.map(cod => ({ cod, tip: D.SERVICIOS[cod].nombre, f: null, ips: null }));\n    }\n    const cola = srvs.map(srv => {\n      const bl = D.BLOQUES[srv.cod]; if (!bl) return null;\n      const forma = D.asignarForma(ses.cc, srv.cod);\n      return { cod: srv.cod, nombre: bl.nombre, c1: bl.c1, c2: bl.c2, forma, srv, pregs: bl.pregs.filter(p => p.forma === \"FIJA\" || p.forma === forma) };\n    }).filter(Boolean);\n    this.setState({ cola, encPhase: \"traz\", trazIdx: 0, blIdx: 0, qIdx: 0, curAns: null, numVal: \"\" });\n  };\n\n  nextQ = () => {\n    const { D, encPhase, trazIdx, cola, blIdx, qIdx } = this.state;\n    const adv = { curAns: null, numVal: \"\" };\n    if (encPhase === \"traz\") {\n      if (trazIdx + 1 < D.TRAZADORAS.length) this.setState({ trazIdx: trazIdx + 1, ...adv });\n      else if (cola.length > 0) this.setState({ encPhase: \"bloque\", blIdx: 0, qIdx: 0, ...adv });\n      else this.setState({ encPhase: \"fin\", ...adv });\n    } else {\n      const bl = cola[blIdx];\n      if (qIdx + 1 < bl.pregs.length) this.setState({ qIdx: qIdx + 1, ...adv });\n      else if (blIdx + 1 < cola.length) this.setState({ blIdx: blIdx + 1, qIdx: 0, ...adv });\n      else this.setState({ encPhase: \"fin\", ...adv });\n    }\n  };\n\n  renderVals() {\n    const S = this.state, D = S.D;\n    const teal = \"#1F8A80\", gray = \"#9BAAA7\";\n    const primerNombre = S.ses ? S.ses.n.split(\" \")[0] : \"\";\n    const h = new Date().getHours();\n    const V = {\n      hora: S.hora, fz: S.fzBig ? 1.15 : 1,\n      spinOn: S.spinOn, spinText: S.spinText,\n      toastOn: !!S.toastMsg, toastMsg: S.toastMsg,\n      isAds: S.screen === \"ads\", isId: S.screen === \"id\", isOtp: S.screen === \"otp\",\n      isVerify: S.screen === \"verify\", isTabs: S.screen === \"tabs\", isResume: S.screen === \"resume\",\n      fecha: new Date().toLocaleDateString(\"es-CO\", { day: \"numeric\", month: \"long\", year: \"numeric\" }),\n      saludo: h < 12 ? \"Buenos días,\" : h < 18 ? \"Buenas tardes,\" : \"Buenas noches,\",\n      irOncas: () => this.toast(\"Abre el tablero ONCAS en minsalud.gov.co\"),\n      // ads\n      ad0: S.adIdx === 0, ad1: S.adIdx === 1, ad2: S.adIdx === 2,\n      adLast: S.adIdx === 2, adNotLast: S.adIdx < 2,\n      adDots: [0, 1, 2].map(i => ({ w: i === S.adIdx ? \"22px\" : \"8px\", bg: i === S.adIdx ? \"#32B1A5\" : \"#D5E3E0\" })),\n      nextAd: () => this.setState({ adIdx: Math.min(2, S.adIdx + 1) }),\n      prevAd: () => this.setState({ adIdx: Math.max(0, S.adIdx - 1) }),\n      skipAds: () => this.setState({ screen: \"id\" }),\n      // sesión guardada\n      resumeSes: () => this.setState({ screen: \"tabs\", tab: \"inicio\" }),\n      logout: () => {\n        try { localStorage.removeItem(\"clicsalud_sesion_v1\"); } catch (e) {}\n        this.setState({ screen: \"id\", ses: null, guest: false, cedula: \"\", otpVal: \"\", encPhase: \"inicio\", trazIdx: 0, blIdx: 0, qIdx: 0, selSrv: {}, tab: \"inicio\" });\n      },\n      guestGoDes: () => this.setState({ screen: \"tabs\", guest: true, ses: null, notFound: false, tab: \"desempeno\" }),\n      guestGoDer: () => this.setState({ screen: \"tabs\", guest: true, ses: null, notFound: false, tab: \"derechos\" }),\n      // letra\n      fzNormal: () => this.setState({ fzBig: false }),\n      fzGrande: () => this.setState({ fzBig: true }),\n      fzNBg: !S.fzBig ? \"#fff\" : \"transparent\", fzNFc: !S.fzBig ? \"#1F8A80\" : \"#8AA09D\",\n      fzGBg: S.fzBig ? \"#fff\" : \"transparent\", fzGFc: S.fzBig ? \"#1F8A80\" : \"#8AA09D\",\n      // id\n      tipoDoc: S.tipoDoc, onTipoDoc: e => this.setState({ tipoDoc: e.target.value }),\n      cedula: S.cedula,\n      onCedula: e => this.setState({ cedula: e.target.value.replace(/\\D/g, \"\").slice(0, 12), ccErr: false }),\n      ccErr: S.ccErr, ccBorder: S.ccErr ? \"#C62828\" : \"#003189\",\n      submitId: () => {\n        if (S.cedula.length < 7) { this.setState({ ccErr: true }); return; }\n        this.spin(\"Enviando código SMS…\", 900, () => {\n          const code = String(Math.floor(1000 + Math.random() * 9000));\n          console.log(\"OTP:\", code);\n          this.setState({ screen: \"otp\", otpCode: code, otpVal: \"\", otpErr: false });\n          setTimeout(() => this.otpRef.current && this.otpRef.current.focus(), 300);\n        });\n      },\n      // otp\n      otpRef: this.otpRef, otpVal: S.otpVal, otpCode: S.otpCode, otpErr: S.otpErr,\n      focusOtp: () => this.otpRef.current && this.otpRef.current.focus(),\n      onOtp: e => this.setState({ otpVal: e.target.value.replace(/\\D/g, \"\").slice(0, 4), otpErr: false }),\n      otpBoxes: [0, 1, 2, 3].map(i => ({\n        d: S.otpVal[i] || \"\",\n        bc: S.otpErr ? \"#C62828\" : i === S.otpVal.length ? \"#32B1A5\" : \"#003189\"\n      })),\n      confirmOtp: () => {\n        if (S.otpVal.length < 4 || S.otpVal !== S.otpCode) { this.setState({ otpErr: true }); return; }\n        this.spin(\"Consultando BDUA…\", 1100, () => {\n          const bd = D && D.BDUA[S.cedula];\n          if (!bd || bd.estado === \"NO AFILIADO\") this.setState({ screen: \"verify\", notFound: true, ses: null });\n          else this.setState({ screen: \"verify\", notFound: false, ses: this._mkSes(S.cedula, bd, D) });\n        });\n      },\n      backToId: () => this.setState({ screen: \"id\", otpVal: \"\", otpErr: false }),\n      // verify\n      notFound: S.notFound, found: !S.notFound && !!S.ses,\n      verTitle: S.notFound ? \"No fue posible verificar\" : \"Verificación BDUA\",\n      verSub: S.notFound ? \"Su documento no aparece como afiliado activo\" : \"Paso 3 de 3 · Confirme que sus datos son correctos\",\n      sesNombre: S.ses ? S.ses.n : \"\", sesEps: S.ses ? S.ses.eps : \"\",\n      sesTipo: S.ses ? S.ses.t : \"\", sesMun: S.ses ? S.ses.m : \"\", sesDpto: S.ses ? S.ses.dpto : \"\",\n      sesPrimerNombre: primerNombre,\n      hasSes: !!S.ses, isGuest: S.guest && !S.ses,\n      iniNombre: S.ses ? primerNombre : \"Bienvenido\",\n      iniChip: S.ses ? (S.ses.eps + \" · \" + S.ses.t) : \"Modo consulta · Sin afiliación activa\",\n      iniDotC: S.ses ? \"#57C231\" : \"#F2B33D\",\n      logoutLbl: S.ses ? \"Cerrar sesión\" : \"Identificarse\",\n      rankTitle: S.guest && !S.ses ? \"Compare y elija su EPS\" : \"Comparativo entre EPS\",\n      confirmVerify: () => {\n        try { localStorage.setItem(\"clicsalud_sesion_v1\", JSON.stringify({ cc: S.ses.cc, ts: Date.now() })); } catch (e) {}\n        this.setState({ screen: \"tabs\", tab: \"inicio\" });\n      },\n      // tabs\n      tabIni: S.tab === \"inicio\", tabDer: S.tab === \"derechos\" && !S.deck && !S.verOn,\n      tabDes: S.tab === \"desempeno\", tabEnc: S.tab === \"encuesta\", tabNor: S.tab === \"normas\",\n      tabIniC: S.tab === \"inicio\" ? teal : gray,\n      tabDerC: S.tab === \"derechos\" ? teal : gray,\n      tabDesC: S.tab === \"desempeno\" ? teal : gray,\n      tabEncC: S.tab === \"encuesta\" ? teal : gray,\n      tabNorC: S.tab === \"normas\" ? teal : gray,\n      setTabIni: () => this.setState({ tab: \"inicio\", deck: null, verOn: false }),\n      setTabDer: () => this.setState({ tab: \"derechos\", deck: null, verOn: false }),\n      setTabDes: () => this.setState({ tab: \"desempeno\", deck: null, verOn: false }),\n      setTabEnc: () => this.setState({ tab: \"encuesta\", deck: null, verOn: false }),\n      setTabNor: () => this.setState({ tab: \"normas\", deck: null, verOn: false }),\n      finGoDer: () => this.setState({ tab: \"derechos\", deck: null, verOn: false }),\n      finGoDes: () => this.setState({ tab: \"desempeno\", deck: null, verOn: false }),\n      finGoNor: () => this.setState({ tab: \"normas\", deck: null, verOn: false }),\n      openVer: () => this.setState({ verOn: true, verIdx: 0, verDone: false, verAns: {} }),\n      openVerDes: () => this.setState({ tab: \"derechos\", deck: null, verOn: true, verIdx: 0, verDone: false, verAns: {} }),\n      closeVer: () => this.setState({ verOn: false })\n    };\n    if (!D) return { ...V, decksV: [], epsListV: [], epsOpts: [], verOptsV: [], verEscalaV: [], verOpen: false, epsNotPicked: true, epsCount: \"\", attrsV: [], rankingV: [], regionesV: [], trendLabels: [], normasV: [], serviciosV: [], srvChecksV: [], qOptsV: [], escalaV: [], encInicio: true, encPregunta: false, encFin: false, esContributivo: true, esSubsidiado: false, sinServicios: false, deckOpen: false, myScore: \"—\", natScore: \"—\", myScoreW: \"0%\", scoreColor: \"#1F8A80\", trendEps: \"\", trendNat: \"\" };\n\n    // ── derechos ──\n    V.decksV = D.DECKS.map((d, i) => ({\n      titulo: d.titulo, sub: d.sub, c1: d.c1, c2: d.c2, num: i + 1, count: d.cards.length,\n      open: () => this.setState({ deck: d, cardIdx: 0 })\n    }));\n    const myEps = S.ses ? S.ses.eps : \"\";\n    V.epsListV = D.EPS_LIST.map(e => ({\n      n: e.n, reg: e.reg, af: e.af, v: e.v,\n      ini: e.n.replace(\"EPS\", \"\").trim().slice(0, 2).toUpperCase(),\n      mia: e.n === myEps ? \"· SU EPS\" : \"\",\n      bc: \"#003189\",\n      ver: () => this.toast(\"Carta de \" + e.n + \" — PDF de ejemplo\")\n    }));\n    V.epsCount = D.EPS_LIST.length;\n    // desplegable de EPS + enlace al sitio oficial\n    const epsSel = S.epsSel || (S.ses ? \"\" : \"\");\n    V.epsOpts = D.EPS_LIST.map(e => ({ n: e.n }));\n    V.epsSel = epsSel;\n    V.onEpsSel = e => this.setState({ epsSel: e.target.value });\n    const pick = D.EPS_LIST.find(e => e.n === epsSel);\n    V.epsPicked = !!pick; V.epsNotPicked = !pick;\n    if (pick) {\n      V.epsNombre = pick.n; V.epsReg = pick.reg; V.epsAf = pick.af; V.epsV = pick.v;\n      const full = /^https?:\\/\\//.test(pick.url) ? pick.url : \"https://\" + pick.url;\n      V.epsUrl = full; V.epsUrlCorta = full.replace(/^https?:\\/\\//, \"\");\n    }\n    // ── encuesta de verificación (art. 5 y 6) ──\n    const VQ = D.VERIFICACION;\n    V.verOpen = S.verOn;\n    V.verTotal = VQ.length;\n    V.verFin = S.verOn && S.verDone;\n    V.verActiva = S.verOn && !S.verDone;\n    V.verRespondidas = Object.keys(S.verAns).length;\n    V.verRad = \"VF-\" + (S.ses ? S.ses.cc.slice(-4) : \"0000\") + \"-\" + String(new Date().getFullYear());\n    if (S.verOn && !S.verDone) {\n      const vq = VQ[S.verIdx], cur = S.verAns[S.verIdx];\n      V.verNum = S.verIdx + 1; V.verText = vq.q; V.verArt = vq.art;\n      V.verIsOpts = vq.tipo === \"opts\" || vq.tipo === \"sino\";\n      V.verIsEscala = vq.tipo === \"escala10\";\n      const vopts = vq.tipo === \"sino\" ? [\"Sí\", \"No\"] : (vq.opts || []);\n      V.verOptsV = vopts.map(label => {\n        const sel = cur === label;\n        return { label, sel, bg: sel ? \"#EAF0FA\" : \"#fff\", fw: sel ? 800 : 600, rBg: sel ? \"#003189\" : \"#fff\",\n          pick: () => this.setState({ verAns: { ...S.verAns, [S.verIdx]: label } }) };\n      });\n      V.verEscalaV = Array.from({ length: 10 }, (_, i) => {\n        const n = i + 1, sel = cur === n;\n        return { n, bg: sel ? \"#003189\" : \"#fff\", fc: sel ? \"#fff\" : \"#003189\",\n          pick: () => this.setState({ verAns: { ...S.verAns, [S.verIdx]: n } }) };\n      });\n      V.verProgW = Math.round(((S.verIdx + 1) / VQ.length) * 100) + \"%\";\n      V.verNextLbl = S.verIdx + 1 >= VQ.length ? \"Finalizar ✓\" : \"Siguiente →\";\n      V.verNext = () => {\n        if (S.verIdx + 1 >= VQ.length) this.setState({ verDone: true });\n        else this.setState({ verIdx: S.verIdx + 1 });\n      };\n    } else { V.verOptsV = []; V.verEscalaV = []; V.verIsOpts = false; V.verIsEscala = false; }\n    V.deckOpen = !!S.deck;\n    if (S.deck) {\n      const dk = S.deck, c = dk.cards[S.cardIdx];\n      V.dkTitulo = dk.titulo; V.dkSub = dk.sub; V.dkC1 = dk.c1; V.dkC2 = dk.c2;\n      V.cardT = c.t; V.cardD = c.d;\n      V.dkNum = S.cardIdx + 1; V.dkTotal = dk.cards.length;\n      V.dkProg = Math.round(((S.cardIdx + 1) / dk.cards.length) * 100) + \"%\";\n      V.dkNextLbl = S.cardIdx + 1 >= dk.cards.length ? \"Terminar ✓\" : \"Siguiente tarjeta →\";\n      V.prevCard = () => this.setState({ cardIdx: Math.max(0, S.cardIdx - 1) });\n      V.nextCard = () => {\n        if (S.cardIdx + 1 >= dk.cards.length) this.setState({ deck: null });\n        else this.setState({ cardIdx: S.cardIdx + 1 });\n      };\n      V.closeDeck = () => this.setState({ deck: null });\n    }\n    // ── desempeño ──\n    const rk = D.DESEMPENO.ranking;\n    const mine = rk.find(r => r.n === myEps);\n    const myScore = mine ? mine.v : 70;\n    V.myScore = myScore; V.natScore = D.DESEMPENO.nacional;\n    V.myScoreW = myScore + \"%\";\n    V.scoreColor = myScore >= 72 ? \"#1F8A5E\" : myScore >= 60 ? \"#E65100\" : \"#C62828\";\n    const attrs = D.DESEMPENO.atributos[myEps] || D.DESEMPENO.atributos.default;\n    V.attrsV = attrs.map(a => ({ a: a.a, v: a.v, w: a.v + \"%\", nw: a.n + \"%\" }));\n    V.rankingV = rk.map((r, i) => ({\n      pos: i + 1, n: r.n, v: r.v, w: r.v + \"%\",\n      fw: r.n === myEps ? 900 : 700, fc: r.n === myEps ? \"#14201F\" : \"#5B6B69\",\n      bg: r.n === myEps ? \"linear-gradient(90deg,#32B1A5,#57C231)\" : \"#C9DAD6\"\n    }));\n    const T = D.DESEMPENO.tendencia;\n    const pt = arr => arr.map((v, i) => (10 + i * 70) + \",\" + (105 - (v - 50) * 2.6)).join(\" \");\n    V.trendEps = pt(T.eps); V.trendNat = pt(T.nacional);\n    V.trendLabels = T.labels.map(y => ({ y }));\n    const maxPart = Math.max(...D.DESEMPENO.regiones.map(r => r.part));\n    V.regionesV = D.DESEMPENO.regiones.map(r => ({\n      n: r.n, part: r.part.toLocaleString(\"es-CO\"), w: Math.round((r.part / maxPart) * 100) + \"%\"\n    }));\n    V.normasV = D.NORMAS.map(n => ({ n: n.n, d: n.d }));\n    // ── encuesta ──\n    const ses = S.ses;\n    V.encLocked = S.guest && !ses;\n    V.encInicio = !V.encLocked && S.encPhase === \"inicio\";\n    V.encPregunta = S.encPhase === \"traz\" || S.encPhase === \"bloque\";\n    V.encFin = S.encPhase === \"fin\";\n    V.esContributivo = !ses || ses.reg === \"contributivo\";\n    V.esSubsidiado = !!ses && ses.reg === \"subsidiado\";\n    const srvs = ses && ses.srvs ? ses.srvs : [];\n    V.sinServicios = V.esContributivo && srvs.length === 0;\n    V.serviciosV = srvs.map(s => {\n      const bl = D.BLOQUES[s.cod];\n      return {\n        tip: s.tip, c1: bl.c1, c2: bl.c2,\n        detalle: (s.f ? new Date(s.f + \"T00:00:00\").toLocaleDateString(\"es-CO\", { day: \"numeric\", month: \"long\", year: \"numeric\" }) : \"Últimos 6 meses\") + (s.ips ? \" · \" + s.ips : \"\")\n      };\n    });\n    V.srvChecksV = Object.keys(D.SERVICIOS).map(cod => {\n      const on = !!S.selSrv[cod];\n      return {\n        nombre: D.SERVICIOS[cod].nombre, desc: D.SERVICIOS[cod].desc, on,\n        bg: on ? \"#EAF0FA\" : \"#fff\",\n        bc: \"#003189\",\n        boxBc: \"#003189\", boxBg: on ? \"#003189\" : \"#fff\",\n        toggle: () => this.setState({ selSrv: { ...S.selSrv, [cod]: !on } })\n      };\n    });\n    V.startEnc = this.startEnc;\n    V.resetEnc = () => this.setState({ encPhase: \"inicio\", trazIdx: 0, blIdx: 0, qIdx: 0, curAns: null, selSrv: {} });\n    let q = null, qNum = 0, qTotal = 1, blk = null;\n    if (S.encPhase === \"traz\") { q = D.TRAZADORAS[S.trazIdx]; qNum = S.trazIdx + 1; qTotal = D.TRAZADORAS.length; }\n    else if (S.encPhase === \"bloque\" && S.cola[S.blIdx]) { blk = S.cola[S.blIdx]; q = blk.pregs[S.qIdx]; qNum = S.qIdx + 1; qTotal = blk.pregs.length; }\n    if (q) {\n      V.qText = q.q; V.qDim = q.dim; V.qNum = qNum;\n      V.qIsOpts = q.tipo === \"opts\" || q.tipo === \"sino\";\n      V.qIsEscala = q.tipo === \"escala10\"; V.qIsNum = q.tipo === \"num\";\n      const opts = q.tipo === \"sino\" ? [\"Sí\", \"No\"] : (q.opts || []);\n      V.qOptsV = opts.map(label => {\n        const sel = S.curAns === label;\n        return {\n          label, sel,\n          bc: \"#003189\", bg: sel ? \"#EAF0FA\" : \"#fff\",\n          fc: \"#003189\", fw: sel ? 800 : 600,\n          rBc: \"#003189\", rBg: sel ? \"#003189\" : \"#fff\",\n          pick: () => this.setState({ curAns: label })\n        };\n      });\n      V.escalaV = Array.from({ length: 10 }, (_, i) => {\n        const n = i + 1, sel = S.curAns === n;\n        return {\n          n, bc: \"#003189\",\n          bg: sel ? \"#003189\" : \"#fff\",\n          fc: sel ? \"#fff\" : \"#003189\",\n          pick: () => this.setState({ curAns: n })\n        };\n      });\n      V.numVal = S.numVal;\n      V.onNum = e => this.setState({ numVal: e.target.value.replace(/\\D/g, \"\") });\n      if (blk) {\n        V.qC1 = blk.c1; V.qC2 = blk.c2;\n        V.qHdr = blk.nombre;\n        V.qSubHdr = \"Bloque \" + (S.blIdx + 1) + \" de \" + S.cola.length + \" · Cod. \" + blk.cod;\n        V.qFormaOn = true; V.qForma = blk.forma;\n        const done = S.cola.slice(0, S.blIdx).reduce((a, b) => a + b.pregs.length, 0) + S.qIdx;\n        const tot = S.cola.reduce((a, b) => a + b.pregs.length, 0);\n        V.progW = Math.round((done / tot) * 100) + \"%\";\n        V.progLbl = \"Bloque \" + (S.blIdx + 1) + \"/\" + S.cola.length + \" · Pregunta \" + qNum + \"/\" + qTotal;\n        V.nextLbl = (S.qIdx + 1 >= blk.pregs.length && S.blIdx + 1 >= S.cola.length) ? \"Finalizar ✓\" : \"Siguiente →\";\n      } else {\n        V.qC1 = \"#32B1A5\"; V.qC2 = \"#57C231\";\n        V.qHdr = \"Preguntas generales\";\n        V.qSubHdr = \"Trazadoras · \" + qNum + \" de \" + qTotal;\n        V.qFormaOn = false; V.qForma = \"\";\n        V.progW = Math.round(((qNum - 1) / qTotal) * 100) + \"%\";\n        V.progLbl = \"Pregunta \" + qNum + \" de \" + qTotal;\n        V.nextLbl = \"Siguiente →\";\n      }\n    } else { V.qOptsV = []; V.escalaV = []; V.qIsOpts = false; V.qIsEscala = false; V.qIsNum = false; }\n    V.nextQ = this.nextQ;\n    return V;\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>